---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);
---

<Layout
  title={`Argomenti tecnici | ${config.site.title}`}
  description="Esplora gli articoli di Giulio Lattanzio per tecnologia, protocollo e argomento: Wi-Fi, Ekahau, networking, Fortinet, Alcatel, SIP, AudioCodes e altro."
>
  <div class="gl-shell">
    <PersonalHeader active="articoli" />

    <main>
      <section class="gl-section topics-hero">
        <div class="gl-wrap">
          <a class="gl-back" href="/posts/">← Knowledge Hub</a>
          <p class="gl-eyebrow">Argomenti</p>
          <h1 class="gl-title">Tecnologie, protocolli e <span>temi specifici.</span></h1>
          <p class="gl-lead">
            Le macro-aree organizzano il sito; i tag permettono di scendere nel dettaglio e trovare gli articoli
            dedicati a strumenti, vendor, protocolli e attività tecniche specifiche.
          </p>
        </div>
      </section>

      <section class="gl-section gl-section-white tags-section">
        <div class="gl-wrap">
          <div class="tags-head">
            <div>
              <p class="gl-eyebrow">Indice</p>
              <h2>Tutti gli argomenti pubblicati.</h2>
            </div>
            <a href="/search/">Cerca nei contenuti →</a>
          </div>

          <div class="tag-grid">
            {tags.map(({ tag, tagName }) => (
              <a class="tag-card" href={`/tags/${tag}/`}>
                <span>#</span>
                <strong>{tagName}</strong>
                <small>Vedi gli articoli →</small>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <PersonalFooter />
  </div>
</Layout>

<style>
  .topics-hero { padding-top: 100px; padding-bottom: 95px; }
  .topics-hero .gl-lead { max-width: 820px; }

  .tags-section { padding-top: 100px; padding-bottom: 110px; }

  .tags-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 38px;
  }

  .tags-head h2 {
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -.05em;
  }

  .tags-head > a {
    color: #2563eb;
    text-decoration: none;
    font-size: 14px;
    font-weight: 750;
    white-space: nowrap;
  }

  .tag-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .tag-card {
    display: grid;
    min-height: 165px;
    gap: 12px;
    padding: 26px;
    border: 1px solid rgba(11, 18, 32, .12);
    border-radius: 16px;
    background: #fff;
    color: #0b1220;
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }

  .tag-card > span {
    color: #2563eb;
    font-family: monospace;
    font-size: 13px;
  }

  .tag-card strong {
    align-self: end;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -.025em;
  }

  .tag-card small {
    color: rgba(11, 18, 32, .58);
    font-size: 12px;
  }

  .tag-card:hover {
    transform: translateY(-2px);
    border-color: rgba(11, 18, 32, .28);
    box-shadow: 0 14px 34px rgba(11, 18, 32, .06);
  }

  @media (max-width: 850px) {
    .tag-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 650px) {
    .topics-hero { padding-top: 72px; padding-bottom: 76px; }
    .tags-section { padding-top: 76px; padding-bottom: 82px; }
    .tags-head { align-items: flex-start; flex-direction: column; }
    .tag-grid { grid-template-columns: 1fr; }
    .tag-card { min-height: 145px; padding: 24px; }
  }
</style>
