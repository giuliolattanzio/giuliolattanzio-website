---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getSortedPosts(
      posts.filter(({ data }) => slugifyAll(data.tags).includes(tag))
    );

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, tagName } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const isFirstPage = page.currentPage === 1;
const pageTitle = isFirstPage
  ? `${tagName}: articoli e approfondimenti | ${config.site.title}`
  : `${tagName} – Pagina ${page.currentPage} | ${config.site.title}`;
const pageDescription = isFirstPage
  ? `Articoli, note e approfondimenti tecnici di Giulio Lattanzio dedicati a ${tagName}.`
  : `Archivio degli articoli dedicati a ${tagName}, pagina ${page.currentPage}.`;
const formatDate = (date: Date) => new Intl.DateTimeFormat("it-IT", {
  day: "2-digit",
  month: "short",
  year: "numeric",
}).format(date);
---

<Layout title={pageTitle} description={pageDescription} robots="noindex,follow">
  <div class="gl-shell">
    <PersonalHeader active="articoli" />

    <main>
      <section class="gl-section tag-hero">
        <div class="gl-wrap">
          <div class="tag-navigation">
            <a class="gl-back" href="/posts/">← Knowledge Hub</a>
            <a href="/tags/">Tutti gli argomenti →</a>
          </div>
          <p class="gl-eyebrow">Argomento</p>
          <h1 class="gl-title">Articoli su <span>{tagName}.</span></h1>
          <p class="gl-lead">Note, analisi e approfondimenti tecnici associati a {tagName}.</p>
        </div>
      </section>

      <section class="gl-section gl-section-white tag-archive">
        <div class="gl-wrap">
          <div class="tag-archive-head">
            <div>
              <p class="gl-eyebrow">Archivio</p>
              <h2>{isFirstPage ? `Contenuti dedicati a ${tagName}.` : `Contenuti — pagina ${page.currentPage}.`}</h2>
            </div>
          </div>

          <div class="article-grid">
            {page.data.map(post => {
              const image = post.data.ogImage || "/default-og.jpg";
              return (
                <a class="article-card" href={getPostUrl(post.id, post.filePath, locale)}>
                  <div class="article-media">
                    <img src={image} alt={post.data.title} loading="lazy" decoding="async" />
                  </div>
                  <div class="article-body">
                    <div class="article-meta">
                      <time datetime={post.data.pubDatetime.toISOString()}>{formatDate(post.data.pubDatetime)}</time>
                      {post.data.tags?.[0] && <span>{post.data.tags[0]}</span>}
                    </div>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <div class="gl-tag-list card-tags">
                      {post.data.tags.slice(0, 4).map(tag => <span class="gl-tag">{tag}</span>)}
                    </div>
                    <span class="read-more">Leggi l’articolo →</span>
                  </div>
                </a>
              );
            })}
          </div>

          {(page.url.prev || page.url.next) && (
            <nav class="gl-pagination" aria-label={`Paginazione articoli su ${tagName}`}>
              <span>{page.url.prev && <a href={page.url.prev}>← Più recenti</a>}</span>
              <span>{page.url.next && <a href={page.url.next}>Più vecchi →</a>}</span>
            </nav>
          )}
        </div>
      </section>
    </main>

    <PersonalFooter />
  </div>
</Layout>

<style>
  .tag-hero { padding-top: 95px; padding-bottom: 90px; }
  .tag-hero .gl-lead { max-width: 760px; }
  .tag-navigation { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 36px; }
  .tag-navigation > a:last-child { color: #2563eb; text-decoration: none; font-size: 13px; font-weight: 750; }
  .tag-archive { padding-top: 95px; padding-bottom: 105px; }
  .tag-archive-head { margin-bottom: 36px; }
  .tag-archive-head h2 { margin: 0; color: #0b1220; font-size: clamp(2.3rem,4vw,3.5rem); line-height: 1.04; letter-spacing: -.05em; }

  .article-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 26px; }
  .article-card { overflow: hidden; display: flex; min-height: 100%; flex-direction: column; border: 1px solid rgba(11,18,32,.12); border-radius: 20px; background: #fff; color: inherit; text-decoration: none; box-shadow: 0 8px 28px rgba(11,18,32,.035); transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
  .article-card:hover { transform: translateY(-5px); border-color: rgba(37,99,235,.28); box-shadow: 0 20px 48px rgba(11,18,32,.09); }
  .article-media { aspect-ratio: 16/9; overflow: hidden; background: #eef2f7; }
  .article-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .article-card:hover .article-media img { transform: scale(1.025); }
  .article-body { display: flex; flex: 1; flex-direction: column; padding: 22px 22px 24px; }
  .article-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: rgba(11,18,32,.50); font-size: 11px; font-weight: 750; letter-spacing: .045em; text-transform: uppercase; }
  .article-card h3 { margin: 18px 0 11px; color: #0b1220; font-size: clamp(1.3rem,2vw,1.65rem); line-height: 1.18; letter-spacing: -.04em; }
  .article-card p { margin: 0; color: rgba(11,18,32,.64); font-size: 14px; line-height: 1.68; }
  .card-tags { margin-top: 18px; }
  .read-more { margin-top: auto; padding-top: 24px; color: #2563eb; font-size: 13px; font-weight: 800; }

  @media (max-width: 1050px) { .article-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 650px) {
    .tag-hero { padding-top: 70px; padding-bottom: 74px; }
    .tag-archive { padding-top: 74px; padding-bottom: 82px; }
    .tag-navigation { align-items: flex-start; flex-direction: column; margin-bottom: 30px; }
    .article-grid { grid-template-columns: 1fr; gap: 20px; }
    .article-body { padding: 20px; }
  }
</style>
