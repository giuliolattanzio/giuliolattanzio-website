---
import { getRelativeLocaleUrl } from "astro:i18n";
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search !== "pagefind" && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const backUrl = `${Astro.url.pathname}`;
const pagefindBundlePath = getAssetPath("pagefind/");
---

<Layout
  title={`Cerca nel Knowledge Hub | ${config.site.title}`}
  description="Cerca negli articoli e negli approfondimenti tecnici di Giulio Lattanzio su Wi-Fi, networking, sicurezza, VoIP e AudioCodes."
>
  <div class="gl-shell">
    <PersonalHeader active="search" />

    <main>
      <section class="gl-section search-section">
        <div class="gl-wrap search-hero">
          <a class="gl-back" href="/posts/">← Knowledge Hub</a>
          <p class="gl-eyebrow">Ricerca</p>
          <h1 class="gl-title">Trova un <span>contenuto tecnico.</span></h1>
          <p class="gl-lead">
            Cerca nel Knowledge Hub tra articoli su Wi-Fi, networking, sicurezza, VoIP, AudioCodes e troubleshooting.
          </p>
        </div>
      </section>

      <section class="gl-section gl-section-white results-section">
        <div class="gl-wrap search-wrap">
          <div class="results-head">
            <p class="gl-eyebrow">Cerca negli articoli</p>
            <h2>Inserisci una tecnologia, un protocollo o un argomento.</h2>
          </div>

          <div
            id="pagefind-search"
            class="gl-search-box"
            transition:persist
            data-backurl={backUrl}
            data-bundle-path={pagefindBundlePath}
          ></div>
        </div>
      </section>
    </main>

    <PersonalFooter />
  </div>
</Layout>

<script>
  function initSearch() {
    const pageFindSearch: HTMLElement | null = document.querySelector("#pagefind-search");
    if (!pageFindSearch) return;

    const bundlePath = pageFindSearch.dataset.bundlePath;
    if (!bundlePath) return;

    const params = new URLSearchParams(window.location.search);
    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    onIdle(async () => {
      // @ts-expect-error Missing types for @pagefind/default-ui.
      const { PagefindUI } = await import("@pagefind/default-ui");

      const search = new PagefindUI({
        element: "#pagefind-search",
        bundlePath,
        showImages: false,
        showSubResults: true,
        processTerm: function (term: string) {
          params.set("q", term);
          history.replaceState(history.state, "", "?" + params.toString());
          const storedBackUrl = pageFindSearch.dataset.backurl ?? window.location.pathname;
          sessionStorage.setItem("backUrl", `${storedBackUrl}?${params.toString()}`);
          return term;
        },
      });

      const query = params.get("q");
      if (query) search.triggerSearch(query);
    });
  }

  document.addEventListener("astro:after-swap", () => {
    const pagefindSearch = document.querySelector("#pagefind-search");
    if (pagefindSearch && pagefindSearch.querySelector("form")) return;
    initSearch();
  });
  initSearch();
</script>

<style>
  .search-section { padding-top: 95px; padding-bottom: 90px; }
  .search-hero { max-width: 900px; }
  .search-hero .gl-lead { max-width: 780px; }
  .results-section { padding-top: 90px; padding-bottom: 105px; }
  .search-wrap { max-width: 900px; }
  .results-head { margin-bottom: 34px; }
  .results-head h2 {
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -.05em;
  }

  @media (max-width: 650px) {
    .search-section { padding-top: 70px; padding-bottom: 74px; }
    .results-section { padding-top: 72px; padding-bottom: 82px; }
  }
</style>

<style is:global>
  #pagefind-search {
    --pagefind-ui-font: Inter, ui-sans-serif, system-ui, sans-serif;
    --pagefind-ui-text: #0b1220;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: rgba(11, 18, 32, 0.12);
    --pagefind-ui-primary: #2563eb;
    --pagefind-ui-tag: rgba(37, 99, 235, 0.035);
    --pagefind-ui-border-radius: 10px;
    --pagefind-ui-border-width: 1px;
  }

  #pagefind-search .pagefind-ui__search-input {
    font-weight: 500;
    border: 1px solid rgba(11, 18, 32, 0.18);
    box-shadow: none;
  }

  #pagefind-search .pagefind-ui__search-input:focus {
    border-color: #2563eb;
    outline: 2px solid rgba(37, 99, 235, 0.12);
  }

  #pagefind-search .pagefind-ui__result {
    border-top: 1px solid rgba(11, 18, 32, 0.12);
    padding: 24px 0;
  }

  #pagefind-search .pagefind-ui__result-title a {
    color: #0b1220;
    text-decoration: none;
    font-weight: 750;
  }

  #pagefind-search .pagefind-ui__result-title a:hover { color: #2563eb; }
  #pagefind-search .pagefind-ui__result-excerpt { color: rgba(11, 18, 32, 0.64); }
</style>
