---
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";

const profileUrl = new URL("/profilo/", Astro.site ?? Astro.url).href;
const personId = `${profileUrl}#person`;
const profileStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": profileUrl,
      url: profileUrl,
      name: "Profilo professionale di Giulio Lattanzio",
      description:
        "Profilo professionale di Giulio Lattanzio, Network, Wi-Fi & VoIP Specialist con focus su Wi-Fi enterprise, wireless engineering, survey Wi-Fi, site survey, Ekahau, RF design e troubleshooting wireless.",
      mainEntity: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "Giulio Lattanzio",
      url: profileUrl,
      jobTitle: "Network, Wi-Fi & VoIP Specialist",
      description:
        "Tecnico specializzato in Wi-Fi enterprise e wireless engineering, con esperienza in progettazione e analisi Wi-Fi, survey Wi-Fi, site survey passive e attive, Ekahau, RF design, roaming e troubleshooting wireless.",
      knowsAbout: [
        "Wi-Fi enterprise",
        "Wireless Engineering",
        "Survey Wi-Fi",
        "Site Survey Wi-Fi",
        "Ekahau",
        "RF Design",
        "Analisi Wi-Fi",
        "Troubleshooting Wi-Fi",
        "Networking",
        "Fortinet",
        "FortiGate",
        "VoIP",
        "SIP",
        "AudioCodes",
      ],
    },
  ],
};
---

<Layout
  title="Profilo | Giulio Lattanzio – Network, Wi-Fi & VoIP Specialist"
  description="Profilo professionale di Giulio Lattanzio, Network, Wi-Fi & VoIP Specialist con focus su Wi-Fi enterprise, survey Wi-Fi, site survey, Ekahau, RF design e troubleshooting wireless."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(profileStructuredData)}
    />
  </Fragment>

  <div class="gl-shell">
    <PersonalHeader active="profilo" />

    <main>
      <section class="gl-section profile-hero">
        <div class="gl-wrap hero-grid">
          <div>
            <p class="gl-eyebrow">Profilo</p>
            <h1 class="gl-title">Network, Wi-Fi & VoIP <span>Specialist.</span></h1>
            <p class="gl-lead">
              Mi occupo di infrastrutture di rete, wireless enterprise e sistemi di comunicazione IP,
              con il Wi-Fi e il wireless engineering come principale area di specializzazione.
            </p>
            <p class="hero-secondary">
              Nel mio percorso professionale affianco attività di progettazione e analisi Wi-Fi alla gestione
              di tecnologie networking, sicurezza Fortinet, VoIP e soluzioni AudioCodes.
            </p>
          </div>

          <aside class="identity-card" aria-label="Sintesi del profilo professionale">
            <p class="identity-kicker">Giulio Lattanzio</p>
            <h2>Network, Wi-Fi & VoIP Specialist</h2>
            <div class="identity-list">
              <span>Wireless Engineering</span>
              <span>Networking & Security</span>
              <span>VoIP & AudioCodes</span>
            </div>
          </aside>
        </div>
      </section>

      <section class="gl-section gl-section-white journey-section">
        <div class="gl-wrap split">
          <div>
            <p class="gl-eyebrow">Il mio percorso tecnico</p>
            <h2>Un percorso costruito tra infrastrutture, wireless e comunicazioni IP.</h2>
          </div>
          <div class="copy">
            <p class="large">
              Il mio percorso professionale nasce nell'ambito delle infrastrutture di rete e si è sviluppato
              progressivamente verso il wireless enterprise, che oggi rappresenta il principale focus della mia attività tecnica.
            </p>
            <p>
              Lavoro su progettazione, analisi e troubleshooting delle reti Wi-Fi, affiancando queste attività
              alla gestione di infrastrutture IP, sicurezza Fortinet e sistemi di comunicazione VoIP basati su tecnologie AudioCodes.
            </p>
            <p>
              Mi interessa soprattutto comprendere il comportamento reale delle infrastrutture: osservare i dati,
              analizzare i flussi, individuare le cause di un problema e trasformare l'esperienza operativa in conoscenza riutilizzabile.
            </p>
          </div>
        </div>
      </section>

      <section class="method-section">
        <div class="gl-wrap">
          <div class="method-head">
            <div>
              <p class="gl-eyebrow">Metodo di lavoro</p>
              <h2>Analizzare, comprendere, documentare.</h2>
            </div>
            <p>
              Un approccio tecnico orientato alla comprensione del problema, alla verifica dei dati e alla costruzione
              di soluzioni che possano essere spiegate, replicate e migliorate nel tempo.
            </p>
          </div>

          <div class="method-grid">
            <article>
              <span class="method-label">Analisi</span>
              <h3>Osservare prima di intervenire.</h3>
              <p>Capire il comportamento dell'infrastruttura attraverso dati, misure, traffico e osservazione sul campo.</p>
            </article>
            <article>
              <span class="method-label">Troubleshooting</span>
              <h3>Individuare la causa, non solo il sintomo.</h3>
              <p>Affrontare i problemi con un metodo progressivo, verificando ipotesi, dipendenze e comportamento reale dei sistemi.</p>
            </article>
            <article>
              <span class="method-label">Documentazione</span>
              <h3>Trasformare l'esperienza in conoscenza.</h3>
              <p>Organizzare ciò che emerge dall'attività tecnica in note, procedure e approfondimenti riutilizzabili.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="focus-section">
        <div class="gl-wrap">
          <div class="focus-head">
            <div>
              <p class="gl-eyebrow">Focus tecnico</p>
              <h2>Tre aree, un unico percorso professionale.</h2>
            </div>
            <p>
              Il mio profilo tecnico si sviluppa su tre ambiti collegati tra loro, con il Wi-Fi come focus principale
              e networking, sicurezza e comunicazioni IP come componenti complementari dell'infrastruttura.
            </p>
          </div>

          <div class="focus-list">
            <a href="/wifi/">
              <span class="focus-domain">Wireless Engineering</span>
              <div>
                <h3>Wi-Fi & RF</h3>
                <p>Progettazione, survey Wi-Fi e site survey, analisi RF, Ekahau e troubleshooting di reti wireless enterprise.</p>
              </div>
              <span class="focus-arrow" aria-hidden="true">↗</span>
            </a>
            <a href="/networking-security/">
              <span class="focus-domain">Infrastructure & Security</span>
              <div>
                <h3>Networking & Security</h3>
                <p>Infrastrutture IP, segmentazione, Fortinet, FortiGate, VPN e analisi del traffico.</p>
              </div>
              <span class="focus-arrow" aria-hidden="true">↗</span>
            </a>
            <a href="/voip/">
              <span class="focus-domain">Unified Communications</span>
              <div>
                <h3>VoIP & AudioCodes</h3>
                <p>SIP, call flow, SBC, routing, interoperabilità e soluzioni AudioCodes.</p>
              </div>
              <span class="focus-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="site-purpose-section">
        <div class="gl-wrap site-purpose-grid">
          <div>
            <p class="gl-eyebrow">Questo sito</p>
            <h2>Uno spazio personale per documentare esperienza e conoscenza tecnica.</h2>
          </div>
          <div>
            <p>
              Questo sito nasce come spazio personale e professionale per raccontare il mio percorso e raccogliere
              articoli, appunti e approfondimenti tecnici. Non è una vetrina commerciale né un sito dedicato
              all'offerta di servizi o consulenza.
            </p>
          </div>
        </div>
      </section>

      <section class="knowledge-section">
        <div class="gl-wrap next-grid">
          <div>
            <p class="gl-eyebrow">Knowledge Hub</p>
            <h2>Dall'esperienza tecnica agli articoli.</h2>
            <p>Nel Knowledge Hub raccolgo analisi, appunti e approfondimenti su Wi-Fi, networking, sicurezza e comunicazioni IP.</p>
          </div>
          <a class="gl-button white-button" href="/posts/">Esplora gli articoli →</a>
        </div>
      </section>
    </main>

    <PersonalFooter />
  </div>
</Layout>

<style>
  .profile-hero {
    padding-top: 105px;
    padding-bottom: 95px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: 80px;
    align-items: center;
  }

  .hero-secondary {
    max-width: 760px;
    margin: 22px 0 0;
    color: rgba(11,18,32,.62);
    font-size: 16px;
    line-height: 1.8;
  }

  .identity-card {
    padding: 34px;
    border: 1px solid rgba(11,18,32,.1);
    border-radius: 24px;
    background: #0b1220;
    color: #fff;
    box-shadow: 0 30px 70px rgba(11,18,32,.16);
  }

  .identity-kicker {
    margin: 0 0 56px;
    color: rgba(255,255,255,.58);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .identity-card h2 {
    margin: 0;
    max-width: 400px;
    font-size: 31px;
    line-height: 1.08;
    letter-spacing: -.045em;
  }

  .identity-list {
    display: grid;
    gap: 0;
    margin-top: 36px;
    border-top: 1px solid rgba(255,255,255,.16);
  }

  .identity-list span {
    padding: 13px 0;
    border-bottom: 1px solid rgba(255,255,255,.16);
    color: rgba(255,255,255,.78);
    font-size: 13px;
  }

  .split {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 100px;
  }

  .split h2,
  .method-head h2,
  .focus-head h2,
  .site-purpose-grid h2,
  .knowledge-section h2 {
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.3rem,4vw,3.8rem);
    line-height: 1.05;
    letter-spacing: -.055em;
  }

  .copy p {
    color: rgba(11,18,32,.64);
    line-height: 1.8;
  }

  .copy .large {
    margin-top: 0;
    color: #0b1220;
    font-size: 22px;
    line-height: 1.5;
  }

  .method-section {
    padding: 110px 0;
    background: #0b1220;
    color: #fff;
  }

  .method-head,
  .focus-head {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 90px;
    align-items: end;
    margin-bottom: 46px;
  }

  .method-head h2 {
    color: #fff;
  }

  .method-head > p {
    margin: 0;
    color: rgba(255,255,255,.62);
    line-height: 1.8;
  }

  .method-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    border-top: 1px solid rgba(255,255,255,.15);
    border-left: 1px solid rgba(255,255,255,.15);
  }

  .method-grid article {
    min-height: 270px;
    padding: 30px;
    border-right: 1px solid rgba(255,255,255,.15);
    border-bottom: 1px solid rgba(255,255,255,.15);
  }

  .method-label {
    color: #2563eb;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .method-grid h3 {
    margin: 58px 0 14px;
    color: #fff;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -.04em;
  }

  .method-grid p {
    margin: 0;
    color: rgba(255,255,255,.68);
    font-size: 14px;
    line-height: 1.7;
  }

  .focus-section {
    padding: 110px 0;
    background: #fff;
    border-top: 1px solid rgba(11,18,32,.1);
  }

  .focus-head > p {
    margin: 0;
    color: rgba(11,18,32,.62);
    line-height: 1.8;
  }

  .focus-list {
    border-top: 1px solid rgba(11,18,32,.12);
  }

  .focus-list a {
    display: grid;
    grid-template-columns: .8fr 1.6fr auto;
    gap: 34px;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid rgba(11,18,32,.12);
    color: inherit;
    text-decoration: none;
    transition: padding .2s ease;
  }

  .focus-list a:hover {
    padding-left: 10px;
  }

  .focus-domain {
    color: rgba(11,18,32,.5);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .focus-list h3 {
    margin: 0 0 7px;
    color: #0b1220;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -.035em;
  }

  .focus-list p {
    margin: 0;
    color: rgba(11,18,32,.62);
    font-size: 14px;
    line-height: 1.65;
  }

  .focus-arrow {
    color: #2563eb;
    font-size: 20px;
  }

  .site-purpose-section {
    padding: 100px 0;
    background: #f7f8fa;
    border-top: 1px solid rgba(11,18,32,.08);
  }

  .site-purpose-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 90px;
    align-items: start;
  }

  .site-purpose-grid p:not(.gl-eyebrow) {
    margin: 0;
    color: rgba(11,18,32,.64);
    font-size: 16px;
    line-height: 1.85;
  }

  .knowledge-section {
    padding: 105px 0;
    background: #0b1220;
    color: #fff;
  }

  .knowledge-section h2 {
    color: #fff;
  }

  .knowledge-section p:not(.gl-eyebrow) {
    max-width: 700px;
    color: rgba(255,255,255,.72);
    line-height: 1.75;
  }

  .next-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: end;
  }

  .white-button {
    background: #fff;
    color: #0b1220;
  }

  @media(max-width:950px) {
    .hero-grid,
    .split,
    .method-head,
    .focus-head,
    .site-purpose-grid,
    .next-grid {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .method-grid {
      grid-template-columns: 1fr;
      border-left: 0;
    }

    .method-grid article {
      min-height: auto;
      border-left: 1px solid rgba(255,255,255,.15);
    }

    .focus-list a {
      grid-template-columns: 1fr auto;
    }

    .focus-domain {
      grid-column: 1 / -1;
    }
  }

  @media(max-width:650px) {
    .profile-hero {
      padding-top: 70px;
      padding-bottom: 76px;
    }

    .identity-card {
      padding: 26px;
      border-radius: 20px;
    }

    .method-section,
    .focus-section,
    .site-purpose-section {
      padding: 80px 0;
    }

    .method-grid h3 {
      margin-top: 38px;
    }

    .focus-list a {
      gap: 18px;
      padding: 24px 0;
    }
  }
</style>
