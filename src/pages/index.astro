---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Giulio Lattanzio | Network & Security Specialist"
  description="Network & Security Specialist specializzato in infrastrutture enterprise, cybersecurity, Fortinet, AudioCodes, Wi-Fi e sistemi VoIP."
>

  <div class="website">

    <!-- NAVBAR -->
    <header class="navbar">
      <div class="container nav-inner">

        <a href="#home" class="brand" aria-label="Giulio Lattanzio - Home">
          <span class="brand-mark">GL</span>

          <span class="brand-text">
            <strong>Giulio Lattanzio</strong>
            <small>Network & Security</small>
          </span>
        </a>

        <nav class="nav-links" aria-label="Navigazione principale">
          <a href="#about">Chi sono</a>
          <a href="#services">Competenze</a>
          <a href="#method">Come lavoro</a>
          <a href="#technologies">Tecnologie</a>

          <a href="#contact" class="nav-contact">
            Contatti
          </a>
        </nav>

      </div>
    </header>


    <main id="main-content">

      <!-- HERO -->
      <section id="home" class="hero">

        <div class="container hero-grid">

          <div class="hero-content">

            <div class="eyebrow">
              <span class="status-dot"></span>
              Network & Security Specialist
            </div>

            <h1>
              Infrastrutture di rete
              <span>sicure, affidabili</span>
              e progettate per durare.
            </h1>

            <p class="hero-description">
              Progetto, proteggo e ottimizzo infrastrutture di rete enterprise,
              soluzioni Wi-Fi ad alte prestazioni e sistemi di comunicazione VoIP.
              Dalla sicurezza perimetrale alla Unified Communication.
            </p>

            <div class="hero-actions">

              <a
                href="mailto:giulio.lattanzio@gmail.com"
                class="button button-primary"
              >
                Parliamo del tuo progetto

                <span aria-hidden="true">→</span>
              </a>

              <a
                href="#services"
                class="button button-secondary"
              >
                Scopri cosa faccio
              </a>

            </div>


            <div class="hero-skills">

              <span>Fortinet</span>
              <span>AudioCodes</span>
              <span>Enterprise Wi-Fi</span>
              <span>Network Security</span>

            </div>

          </div>


          <!-- VISUAL / FOTO -->
          <div class="hero-visual">

            <div class="visual-decoration decoration-one"></div>
            <div class="visual-decoration decoration-two"></div>

            <div class="portrait-card">

              <!--
                Inserisci una tua foto chiamata profile.jpg
                nella cartella /public

                Se la foto non esiste, viene mostrato
                comunque lo sfondo grafico.
              -->

              <img
                src="/profile.jpg"
                alt="Giulio Lattanzio"
                class="portrait-image"
                onerror="this.remove()"
              />

              <div class="portrait-grid"></div>

              <div class="portrait-info">

                <span class="terminal-label">
                  C:\&gt; whoami
                </span>

                <div>
                  <strong>Giulio Lattanzio</strong>
                  <p>
                    Networking · Security · VoIP
                  </p>
                </div>

              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- PROFESSIONAL AREAS -->
      <section class="specializations">

        <div class="container specialization-grid">

          <div>
            <span class="specialization-number">01</span>
            <strong>Network</strong>
            <p>
              Routing, switching e infrastrutture enterprise.
            </p>
          </div>

          <div>
            <span class="specialization-number">02</span>
            <strong>Security</strong>
            <p>
              Firewall, VPN, segmentazione e protezione perimetrale.
            </p>
          </div>

          <div>
            <span class="specialization-number">03</span>
            <strong>Wireless</strong>
            <p>
              Wi-Fi professionale, site survey e ottimizzazione RF.
            </p>
          </div>

          <div>
            <span class="specialization-number">04</span>
            <strong>VoIP</strong>
            <p>
              SBC, SIP e integrazione delle comunicazioni aziendali.
            </p>
          </div>

        </div>

      </section>


      <!-- ABOUT -->
      <section id="about" class="section">

        <div class="container about-grid">

          <div class="section-heading">

            <span class="section-label">
              C:\&gt; whoami
            </span>

            <h2>
              Tecnologia complessa,
              <span>soluzioni semplici.</span>
            </h2>

          </div>


          <div class="about-content">

            <p class="about-lead">
              Mi occupo di networking e sicurezza informatica con un focus
              particolare sulle infrastrutture aziendali.
            </p>

            <p>
              Lavoro sulla progettazione, configurazione e ottimizzazione di
              ambienti di rete affidabili e sicuri, seguendo il progetto dalla
              fase di analisi fino alla messa in produzione.
            </p>

            <p>
              Il mio approccio combina competenze su
              <strong>Fortinet</strong>,
              <strong>AudioCodes</strong>,
              switching, routing, wireless enterprise e tecnologie VoIP,
              con un obiettivo preciso: creare infrastrutture che siano
              semplici da gestire, resilienti e scalabili.
            </p>

            <div class="about-links">

              <a
                href="https://github.com/giuliolattanzio"
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub
                <span>↗</span>
              </a>

              <a
                href="https://www.linkedin.com/"
                target="_blank"
                rel="noopener noreferrer"
              >
                LinkedIn
                <span>↗</span>
              </a>

            </div>

          </div>

        </div>

      </section>


      <!-- SERVICES -->
      <section id="services" class="section section-light">

        <div class="container">

          <div class="section-intro">

            <div>
              <span class="section-label">
                Competenze
              </span>

              <h2>
                Dove posso fare
                <span>la differenza.</span>
              </h2>
            </div>

            <p>
              Dalla progettazione dell'architettura alla risoluzione dei
              problemi sul campo: un approccio completo alle infrastrutture
              di rete e comunicazione.
            </p>

          </div>


          <div class="services-grid">

            <!-- SERVICE 01 -->
            <article class="service-card">

              <div class="service-top">
                <span class="service-number">01</span>

                <div class="service-icon">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 3l8 4v5c0 5-3.4 8-8 9-4.6-1-8-4-8-9V7l8-4z"
                    />
                    <path d="M9 12l2 2 4-4" />
                  </svg>
                </div>
              </div>

              <h3>
                Network Security
                <br />
                & Fortinet
              </h3>

              <p>
                Progettazione e gestione di infrastrutture di sicurezza
                basate su FortiGate e tecnologie Fortinet.
              </p>

              <ul>
                <li>Next Generation Firewall</li>
                <li>VPN IPsec / SSL</li>
                <li>VLAN & segmentazione</li>
                <li>Security policies</li>
                <li>Hardening della rete</li>
              </ul>

            </article>


            <!-- SERVICE 02 -->
            <article class="service-card">

              <div class="service-top">
                <span class="service-number">02</span>

                <div class="service-icon">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="3" />
                    <circle cx="12" cy="12" r="8" />
                    <path d="M12 4v5M12 15v5M4 12h5M15 12h5" />
                  </svg>
                </div>
              </div>

              <h3>
                Enterprise Wi-Fi
                <br />
                & Switching
              </h3>

              <p>
                Progettazione di reti cablate e wireless affidabili,
                performanti e pronte a crescere.
              </p>

              <ul>
                <li>Wireless design</li>
                <li>Site survey</li>
                <li>Analisi spettro RF</li>
                <li>VLAN & switching</li>
                <li>Ottimizzazione prestazioni</li>
              </ul>

            </article>


            <!-- SERVICE 03 -->
            <article class="service-card">

              <div class="service-top">
                <span class="service-number">03</span>

                <div class="service-icon">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M7 4h3l2 5-2 1.5a14 14 0 006 6L17.5 14l5 2v3c0 1.1-.9 2-2 2C11 21 3 13 3 3.5 3 2.7 3.7 2 4.5 2H7"
                    />
                  </svg>
                </div>
              </div>

              <h3>
                VoIP
                <br />
                & AudioCodes
              </h3>

              <p>
                Implementazione e troubleshooting di infrastrutture VoIP
                e Session Border Controller.
              </p>

              <ul>
                <li>AudioCodes SBC</li>
                <li>SIP routing</li>
                <li>Microsoft Teams</li>
                <li>PBX integration</li>
                <li>VoIP troubleshooting</li>
              </ul>

            </article>


            <!-- SERVICE 04 -->
            <article class="service-card">

              <div class="service-top">
                <span class="service-number">04</span>

                <div class="service-icon">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M4 19V9M10 19V5M16 19v-8M22 19V3" />
                  </svg>
                </div>
              </div>

              <h3>
                Analisi
                <br />
                & Troubleshooting
              </h3>

              <p>
                Analisi approfondita di problemi di rete, performance e
                configurazioni esistenti.
              </p>

              <ul>
                <li>Wireshark</li>
                <li>Packet analysis</li>
                <li>Performance analysis</li>
                <li>Network audit</li>
                <li>Ottimizzazione</li>
              </ul>

            </article>

          </div>

        </div>

      </section>


      <!-- METHOD -->
      <section id="method" class="section method">

        <div class="container">

          <div class="section-intro">

            <div>
              <span class="section-label">
                Come lavoro
              </span>

              <h2>
                Dal problema
                <span>alla soluzione.</span>
              </h2>
            </div>

            <p>
              Ogni infrastruttura è diversa. Prima di configurare,
              serve capire come viene utilizzata e quali problemi
              deve realmente risolvere.
            </p>

          </div>


          <div class="method-grid">

            <div class="method-item">

              <span>01</span>

              <h3>Analisi</h3>

              <p>
                Raccolgo requisiti, architettura esistente,
                criticità e obiettivi.
              </p>

            </div>

            <div class="method-item">

              <span>02</span>

              <h3>Progettazione</h3>

              <p>
                Definisco la soluzione tecnica, valutando
                sicurezza, performance e scalabilità.
              </p>

            </div>

            <div class="method-item">

              <span>03</span>

              <h3>Implementazione</h3>

              <p>
                Configuro e integro i sistemi riducendo al minimo
                l'impatto sull'operatività.
              </p>

            </div>

            <div class="method-item">

              <span>04</span>

              <h3>Verifica</h3>

              <p>
                Test, troubleshooting e ottimizzazione completano
                il deployment.
              </p>

            </div>

          </div>

        </div>

      </section>


      <!-- TECHNOLOGIES -->
      <section id="technologies" class="section technologies">

        <div class="container technologies-grid">

          <div>

            <span class="section-label">
              Technology stack
            </span>

            <h2>
              Tecnologie con cui
              <span>lavoro ogni giorno.</span>
            </h2>

          </div>


          <div class="technology-list">

            <span>FortiGate</span>
            <span>Fortinet</span>
            <span>AudioCodes SBC</span>
            <span>Cisco</span>
            <span>HPE Aruba</span>
            <span>SIP</span>
            <span>VoIP</span>
            <span>BGP</span>
            <span>OSPF</span>
            <span>VLAN</span>
            <span>IPsec</span>
            <span>Wireshark</span>
            <span>Microsoft Teams</span>
            <span>Enterprise Wi-Fi</span>

          </div>

        </div>

      </section>


      <!-- CONTACT -->
      <section id="contact" class="contact-section">

        <div class="container">

          <div class="contact-box">

            <span class="contact-label">
              Hai un progetto?
            </span>

            <h2>
              Costruiamo un'infrastruttura
              <span>più sicura e affidabile.</span>
            </h2>

            <p>
              Se stai progettando una nuova infrastruttura,
              vuoi migliorare quella esistente o devi risolvere
              un problema complesso di networking, parliamone.
            </p>

            <div class="contact-actions">

              <a
                href="mailto:giulio.lattanzio@gmail.com"
                class="button button-white"
              >
                giulio.lattanzio@gmail.com
                <span>→</span>
              </a>

              <a
                href="https://www.linkedin.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="contact-link"
              >
                LinkedIn ↗
              </a>

            </div>

          </div>

        </div>

      </section>

    </main>


    <!-- FOOTER -->
    <footer class="footer">

      <div class="container footer-inner">

        <div>
          <strong>Giulio Lattanzio</strong>
          <p>Network & Security Specialist</p>
        </div>

        <p>
          © {new Date().getFullYear()} Giulio Lattanzio
        </p>

      </div>

    </footer>

  </div>

</Layout>


<style>

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
  }

  .website {
    --bg: #f7f9fc;
    --white: #ffffff;
    --text: #101828;
    --muted: #667085;
    --border: #e4e7ec;
    --blue: #2563eb;
    --blue-dark: #1d4ed8;
    --navy: #0b1220;

    width: 100%;
    background: var(--bg);
    color: var(--text);
    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }


  /* NAVBAR */

  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(247, 249, 252, 0.9);
    border-bottom: 1px solid rgba(228, 231, 236, 0.8);
    backdrop-filter: blur(18px);
  }

  .nav-inner {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
    color: var(--text);
  }

  .brand-mark {
    width: 43px;
    height: 43px;
    display: grid;
    place-items: center;
    background: var(--navy);
    color: white;
    border-radius: 12px;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-text strong {
    font-size: 14px;
    line-height: 1.25;
  }

  .brand-text small {
    color: var(--muted);
    font-size: 11px;
    margin-top: 2px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links a {
    color: #475467;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--blue);
  }

  .nav-links .nav-contact {
    color: white;
    background: var(--navy);
    padding: 11px 18px;
    border-radius: 9px;
  }

  .nav-links .nav-contact:hover {
    background: var(--blue);
    color: white;
  }


  /* HERO */

  .hero {
    padding: 105px 0 90px;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 90px;
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--blue);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 25px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 0 5px rgba(34, 197, 94, 0.12);
  }

  .hero h1 {
    margin: 0;
    max-width: 800px;
    color: var(--navy);
    font-size: clamp(3.1rem, 5.3vw, 5.1rem);
    line-height: 1;
    letter-spacing: -0.065em;
    font-weight: 750;
  }

  .hero h1 span,
  .section h2 span {
    color: var(--blue);
  }

  .hero-description {
    max-width: 700px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.75;
    margin: 30px 0 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
    margin-top: 35px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 17px;
    padding: 14px 21px;
    border-radius: 10px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    color: white;
    background: var(--blue);
  }

  .button-primary:hover {
    background: var(--blue-dark);
  }

  .button-secondary {
    color: var(--text);
    background: white;
    border: 1px solid var(--border);
  }

  .hero-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 23px;
    margin-top: 43px;
    color: #98a2b3;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.055em;
  }


  /* HERO VISUAL */

  .hero-visual {
    position: relative;
  }

  .portrait-card {
    position: relative;
    min-height: 540px;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 25%, #243b70 0, transparent 35%),
      linear-gradient(145deg, #111827, #050811);
    border-radius: 26px;
    box-shadow: 0 35px 80px rgba(16, 24, 40, 0.18);
  }

  .portrait-image {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .portrait-grid {
    position: absolute;
    inset: 0;
    opacity: 0.25;
    background-image:
      linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px);
    background-size: 42px 42px;
  }

  .portrait-info {
    position: absolute;
    z-index: 4;
    left: 25px;
    right: 25px;
    bottom: 25px;
    padding: 18px 20px;
    color: white;
    background: rgba(8, 13, 25, 0.72);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .portrait-info strong {
    font-size: 15px;
  }

  .portrait-info p {
    margin: 4px 0 0;
    color: #cbd5e1;
    font-size: 12px;
  }

  .terminal-label {
    color: #60a5fa;
    font-family: monospace;
    font-size: 12px;
  }

  .visual-decoration {
    position: absolute;
    border-radius: 50%;
    filter: blur(1px);
  }

  .decoration-one {
    width: 170px;
    height: 170px;
    right: -70px;
    top: -50px;
    background: rgba(37, 99, 235, 0.12);
  }

  .decoration-two {
    width: 90px;
    height: 90px;
    left: -35px;
    bottom: 35px;
    border: 1px solid rgba(37, 99, 235, 0.3);
  }


  /* SPECIALIZATIONS */

  .specializations {
    background: white;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .specialization-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .specialization-grid > div {
    padding: 32px 26px;
    border-right: 1px solid var(--border);
  }

  .specialization-grid > div:first-child {
    padding-left: 0;
  }

  .specialization-grid > div:last-child {
    border-right: 0;
  }

  .specialization-number {
    display: block;
    color: var(--blue);
    font-family: monospace;
    font-size: 11px;
    margin-bottom: 12px;
  }

  .specialization-grid strong {
    font-size: 17px;
  }

  .specialization-grid p {
    margin: 7px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }


  /* GENERAL SECTIONS */

  .section {
    padding: 120px 0;
  }

  .section-light {
    background: white;
  }

  .section-label {
    display: block;
    color: var(--blue);
    font-family: monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .section h2,
  .contact-section h2 {
    color: var(--navy);
    font-size: clamp(2.3rem, 4vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -0.055em;
    margin: 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 110px;
  }

  .about-content {
    max-width: 650px;
  }

  .about-content p {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.8;
  }

  .about-content .about-lead {
    margin-top: 0;
    color: var(--text);
    font-size: 23px;
    line-height: 1.55;
  }

  .about-content strong {
    color: var(--text);
  }

  .about-links {
    display: flex;
    gap: 30px;
    margin-top: 30px;
  }

  .about-links a {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--blue);
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
  }


  /* SERVICES */

  .section-intro {
    display: grid;
    grid-template-columns: 1fr 0.72fr;
    gap: 90px;
