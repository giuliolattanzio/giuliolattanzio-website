---
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import LatestArticles from "@/components/LatestArticles.astro";
---

<Layout
  title="Giulio Lattanzio | Network, Wi-Fi & VoIP Specialist"
  description="Portfolio personale e raccolta di contenuti tecnici su Wi-Fi, networking, sicurezza, VoIP e AudioCodes."
>
  <div class="gl-shell">
    <PersonalHeader active="home" />

    <main>
      <section class="gl-section home-hero">
        <div class="gl-wrap hero-grid">
          <div>
            <p class="gl-eyebrow">Personal tech portfolio</p>
            <h1 class="gl-title">Wi-Fi, networking e comunicazioni <span>raccontati attraverso esperienza e contenuti tecnici.</span></h1>
            <p class="gl-lead">
              Sono Giulio Lattanzio, Network, Wi-Fi & VoIP Specialist. Il Wi-Fi e il wireless engineering rappresentano
              il principale focus del mio percorso professionale, affiancati da networking, sicurezza e comunicazioni IP.
              Nel mio lavoro mi occupo di progettazione e analisi Wi-Fi, tecnologie Fortinet, VoIP e soluzioni AudioCodes.
            </p>
          </div>

          <figure class="hero-portrait">
            <img
              src="/images/profile/giulio%20lattanzio.png"
              alt="Ritratto di Giulio Lattanzio"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        </div>
      </section>

      <section class="gl-section gl-section-white">
        <div class="gl-wrap split">
          <div>
            <p class="gl-eyebrow">Profilo</p>
            <h2>Il mio percorso tecnico, con il Wi-Fi al centro.</h2>
          </div>
          <div class="copy">
            <p class="large">Mi occupo di infrastrutture di rete, wireless enterprise e sistemi di comunicazione VoIP, con una particolare attenzione alla progettazione e all’analisi Wi-Fi.</p>
            <p>Questo spazio nasce esclusivamente come vetrina personale e professionale, non per offrire servizi o consulenza. L’obiettivo è raccontare il mio percorso tecnico e condividere esperienze, appunti e contenuti su Wi-Fi, networking, sicurezza, VoIP e tecnologie AudioCodes.</p>
            <a class="text-link" href="/profilo/">Scopri il mio profilo →</a>
          </div>
        </div>
      </section>

      <section class="areas-section">
        <div class="gl-wrap">
          <div class="section-head areas-head">
            <div>
              <p class="gl-eyebrow">Aree tecniche</p>
              <h2>Tre aree per organizzare contenuti e approfondimenti tecnici.</h2>
            </div>
            <p>
              Il sito è organizzato in tre macro-aree: Wi-Fi & RF, Networking & Security e VoIP & AudioCodes.
              Il Wi-Fi rappresenta l’area principale, mentre le altre sezioni raccolgono contenuti dedicati alle infrastrutture di rete,
              alla sicurezza e alle comunicazioni IP. Ogni area riunisce articoli, appunti e approfondimenti tecnici in una struttura semplice e coerente.
            </p>
          </div>

          <div class="areas-grid">
            <a class="area-card" href="/wifi/">
              <div class="area-card-top">
                <span class="area-domain">Wireless Engineering</span>
                <span class="area-arrow" aria-hidden="true">↗</span>
              </div>
              <div class="area-card-copy">
                <h3>Wi-Fi & RF</h3>
                <p>Progettazione, analisi e validazione di reti wireless enterprise, con particolare attenzione a RF design, site survey, troubleshooting e utilizzo di Ekahau.</p>
              </div>
              <div class="area-tags area-tags-light" aria-label="Temi Wi-Fi">
                <span>Ekahau</span>
                <span>Site Survey</span>
                <span>Analisi Wi-Fi</span>
              </div>
            </a>

            <a class="area-card" href="/networking-security/">
              <div class="area-card-top">
                <span class="area-domain">Infrastructure & Security</span>
                <span class="area-arrow" aria-hidden="true">↗</span>
              </div>
              <div class="area-card-copy">
                <h3>Networking & Security</h3>
                <p>Gestione e analisi di infrastrutture IP, segmentazione, connettività sicura e troubleshooting, con particolare riferimento alle tecnologie Fortinet e FortiGate.</p>
              </div>
              <div class="area-tags area-tags-light" aria-label="Temi networking e sicurezza">
                <span>Fortinet</span>
                <span>FortiGate</span>
                <span>VLAN</span>
                <span>IPsec</span>
              </div>
            </a>

            <a class="area-card" href="/voip/">
              <div class="area-card-top">
                <span class="area-domain">Unified Communications</span>
                <span class="area-arrow" aria-hidden="true">↗</span>
              </div>
              <div class="area-card-copy">
                <h3>VoIP & AudioCodes</h3>
                <p>Analisi e gestione di comunicazioni VoIP, flussi SIP, routing e SBC, con particolare attenzione all’interoperabilità e alle soluzioni AudioCodes.</p>
              </div>
              <div class="area-tags area-tags-light" aria-label="Temi VoIP e AudioCodes">
                <span>AudioCodes SBC</span>
                <span>SIP</span>
                <span>VoIP</span>
                <span>Microsoft Teams</span>
              </div>
            </a>
          </div>
        </div>
      </section>

      <section id="stack" class="tech-section">
        <div class="gl-wrap">
          <div class="tech-intro">
            <div>
              <p class="gl-eyebrow">Tecnologie & strumenti</p>
              <h2>Tecnologie, piattaforme e strumenti del mio stack tecnico.</h2>
            </div>
            <p>
              Una panoramica sintetica di vendor, strumenti e protocolli che utilizzo nelle attività di progettazione,
              gestione, analisi e troubleshooting delle infrastrutture di rete e comunicazione.
            </p>
          </div>

          <div class="tech-panel">
            <section class="tech-column" aria-labelledby="tech-wireless">
              <h3 id="tech-wireless">Wireless Engineering</h3>
              <ul class="tech-items" aria-label="Tecnologie e strumenti wireless">
                <li>Ekahau</li>
                <li>RF Design</li>
                <li>Site Survey</li>
                <li>Spectrum Analysis</li>
                <li>Enterprise Wi-Fi</li>
                <li>Roaming</li>
              </ul>
            </section>

            <section class="tech-column" aria-labelledby="tech-network">
              <h3 id="tech-network">Network & Security</h3>
              <ul class="tech-items" aria-label="Tecnologie networking e sicurezza">
                <li>Fortinet / FortiGate</li>
                <li>Alcatel</li>
                <li>VLAN</li>
                <li>Routing</li>
                <li>VPN / IPsec</li>
              </ul>
            </section>

            <section class="tech-column" aria-labelledby="tech-voice">
              <h3 id="tech-voice">Voice & Unified Communications</h3>
              <ul class="tech-items" aria-label="Tecnologie VoIP e unified communications">
                <li>AudioCodes SBC</li>
                <li>SIP</li>
                <li>Call Flow</li>
                <li>SIP Routing</li>
                <li>Microsoft Teams</li>
                <li>Interoperabilità</li>
              </ul>
            </section>

            <section class="tech-column" aria-labelledby="tech-analysis">
              <h3 id="tech-analysis">Analysis & Troubleshooting</h3>
              <ul class="tech-items" aria-label="Strumenti di analisi e troubleshooting">
                <li>Wireshark</li>
                <li>Packet Analysis</li>
                <li>Traffic Analysis</li>
                <li>Troubleshooting</li>
              </ul>
            </section>
          </div>
        </div>
      </section>

      <section class="knowledge-section">
        <div class="gl-wrap knowledge-grid">
          <div>
            <p class="gl-eyebrow">Knowledge Hub</p>
            <h2>Esperienze, analisi e approfondimenti tecnici.</h2>
            <p>Uno spazio dedicato alla documentazione tecnica: articoli e approfondimenti su Wi-Fi, networking, sicurezza e comunicazioni IP, costruiti a partire da esperienza operativa, analisi, troubleshooting e studio delle tecnologie.</p>
          </div>
          <a class="gl-button white-button" href="/posts/">Esplora tutti gli articoli →</a>
        </div>
      </section>

      <LatestArticles />
    </main>

    <PersonalFooter />
  </div>
</Layout>

<style>
  .home-hero {
    padding-top: 110px;
    padding-bottom: 105px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: 80px;
    align-items: center;
  }

  .hero-portrait {
    width: min(100%, 420px);
    aspect-ratio: 4 / 5;
    margin: 0;
    justify-self: end;
    overflow: hidden;
    border: 1px solid rgba(11,18,32,.12);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 30px 70px rgba(11,18,32,.12);
  }

  .hero-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .split {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 100px;
  }

  .split h2,
  .section-head h2,
  .knowledge-section h2 {
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.3rem,4vw,3.8rem);
    line-height: 1.05;
    letter-spacing: -.055em;
  }

  .copy p {
    color: rgba(11,18,32,.66);
    line-height: 1.8;
  }

  .copy .large {
    margin-top: 0;
    color: #0b1220;
    font-size: 22px;
    line-height: 1.5;
  }

  .text-link {
    display: inline-block;
    margin-top: 18px;
    color: #2563eb;
    text-decoration: none;
    font-weight: 750;
  }

  .areas-section {
    padding: 110px 0 120px;
    background: #fff;
    border-top: 1px solid rgba(11,18,32,.1);
  }

  .section-head {
    display: grid;
    grid-template-columns: 1fr .75fr;
    gap: 80px;
    align-items: end;
    margin-bottom: 50px;
  }

  .section-head > p {
    margin: 0;
    color: rgba(11,18,32,.64);
    line-height: 1.75;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }

  .area-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 390px;
    padding: 30px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(11,18,32,.12);
    border-radius: 22px;
    color: #0b1220;
    text-decoration: none;
    box-shadow: 0 14px 34px rgba(11,18,32,.035);
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }

  .area-card:hover {
    transform: translateY(-4px);
    border-color: rgba(11,18,32,.28);
    box-shadow: 0 22px 50px rgba(11,18,32,.08);
  }

  .area-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .area-domain {
    color: rgba(11,18,32,.56);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .area-arrow {
    color: #0b1220;
    font-size: 21px;
    line-height: 1;
  }

  .area-card-copy {
    margin-top: 56px;
  }

  .area-card h3 {
    margin: 0 0 12px;
    color: #0b1220;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -.045em;
  }

  .area-card p {
    margin: 0;
    color: rgba(11,18,32,.64);
    font-size: 14px;
    line-height: 1.7;
  }

  .area-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 28px;
  }

  .area-tags span {
    padding: 8px 10px;
    border: 1px solid rgba(11,18,32,.14);
    border-radius: 8px;
    background: #fff;
    color: #0b1220;
    font-family: monospace;
    font-size: 11px;
  }

  .knowledge-section {
    padding: 105px 0;
    background: #0b1220;
    color: #fff;
  }

  .knowledge-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: end;
  }

  .knowledge-section h2 {
    color: #fff;
  }

  .knowledge-section p:not(.gl-eyebrow) {
    max-width: 720px;
    color: rgba(255,255,255,.64);
    line-height: 1.75;
  }

  .white-button {
    background: #fff;
    color: #0b1220;
  }

  .tech-section {
    padding: 110px 0 120px;
    background: #fff;
    border-top: 1px solid rgba(11,18,32,.1);
  }

  .tech-intro {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 90px;
    align-items: end;
    margin-bottom: 46px;
  }

  .tech-intro h2 {
    max-width: 700px;
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.5rem, 4.5vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -.058em;
  }

  .tech-intro > p {
    max-width: 590px;
    margin: 0;
    color: rgba(11,18,32,.64);
    font-size: 16px;
    line-height: 1.8;
  }

  .tech-panel {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    overflow: hidden;
    background: #0b1220;
    border: 1px solid #0b1220;
    border-radius: 24px;
    box-shadow: 0 24px 54px rgba(11,18,32,.14);
  }

  .tech-column {
    position: relative;
    min-width: 0;
    min-height: 300px;
    padding: 30px 28px 32px;
    border-left: 1px solid rgba(255,255,255,.13);
  }

  .tech-column:first-child {
    border-left: 0;
  }

  .tech-column::before {
    content: "";
    display: block;
    width: 26px;
    height: 2px;
    margin-bottom: 22px;
    background: #2563eb;
  }

  .tech-column h3 {
    min-height: 48px;
    margin: 0 0 24px;
    color: #fff;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -.025em;
  }

  .tech-items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tech-items li {
    padding: 10px 0;
    border-top: 1px solid rgba(255,255,255,.11);
    color: rgba(255,255,255,.84);
    font-size: 13px;
    line-height: 1.35;
  }

  .tech-items li:first-child {
    color: #fff;
    font-weight: 700;
  }

  @media(max-width:1050px) {
    .areas-grid {
      grid-template-columns: 1fr 1fr;
    }

    .tech-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tech-column:nth-child(3) {
      border-left: 0;
    }

    .tech-column:nth-child(n+3) {
      border-top: 1px solid rgba(255,255,255,.13);
    }
  }

  @media(max-width:950px) {
    .hero-grid,
    .split,
    .section-head,
    .knowledge-grid,
    .tech-intro {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .hero-portrait {
      justify-self: center;
      width: min(100%,390px);
    }
  }

  @media(max-width:650px) {
    .home-hero {
      padding-top: 70px;
      padding-bottom: 78px;
    }

    .hero-portrait {
      width: min(88vw,360px);
      border-radius: 22px;
    }

    .areas-section,
    .tech-section {
      padding: 80px 0;
    }

    .areas-grid {
      grid-template-columns: 1fr;
    }

    .area-card {
      min-height: 330px;
      padding: 24px;
      border-radius: 18px;
    }

    .area-card-copy {
      margin-top: 44px;
    }

    .tech-panel {
      grid-template-columns: 1fr;
      border-radius: 20px;
    }

    .tech-column {
      min-height: auto;
      padding: 26px;
      border-left: 0;
      border-top: 1px solid rgba(255,255,255,.13);
    }

    .tech-column:first-child {
      border-top: 0;
    }

    .tech-column h3 {
      min-height: 0;
    }
  }
</style>
