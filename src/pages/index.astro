---
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import LatestArticles from "@/components/LatestArticles.astro";
---

<Layout
  title="Giulio Lattanzio | Network & Security Specialist"
  description="Portfolio personale e raccolta di contenuti tecnici su networking, Wi-Fi, VoIP, Fortinet e AudioCodes."
>
  <div class="gl-shell">
    <PersonalHeader active="home" />

    <main>
      <section class="gl-section home-hero">
        <div class="gl-wrap hero-grid">
          <div>
            <p class="gl-eyebrow">Personal tech portfolio</p>
            <h1 class="gl-title">Networking, sicurezza e comunicazioni <span>raccontati attraverso esperienza e contenuti tecnici.</span></h1>
            <p class="gl-lead">
              Sono Giulio Lattanzio, Network & Security Specialist. Questo sito è la mia vetrina professionale:
              racconta chi sono, di cosa mi occupo, le tecnologie con cui lavoro e gli articoli che pubblico su Wi-Fi,
              networking, Fortinet, VoIP e AudioCodes.
            </p>
            <div class="hero-actions">
              <a class="gl-button gl-button-primary" href="/profilo/">Chi sono e cosa faccio</a>
              <a class="gl-button gl-button-secondary" href="/posts/">Leggi gli articoli</a>
            </div>
          </div>

          <aside class="identity-card">
            <div class="identity-top"><span>C:\&gt; whoami</span><small>ONLINE</small></div>
            <div class="identity-main">
              <span class="avatar">GL</span>
              <div><h2>Giulio Lattanzio</h2><p>Network & Security Specialist</p></div>
            </div>
            <div class="identity-tags">
              <span>Networking</span><span>Wi-Fi</span><span>Fortinet</span><span>VoIP</span><span>AudioCodes</span>
            </div>
          </aside>
        </div>
      </section>

      <section class="gl-section gl-section-white">
        <div class="gl-wrap split">
          <div>
            <p class="gl-eyebrow">Profilo</p>
            <h2>Una presentazione di chi sono e di cosa mi occupo.</h2>
          </div>
          <div class="copy">
            <p class="large">Mi occupo di infrastrutture di rete, sicurezza, wireless enterprise e sistemi di comunicazione VoIP.</p>
            <p>Questo spazio non nasce per offrire servizi o consulenza: è una vetrina personale e professionale dove presento le aree tecniche su cui lavoro e raccolgo contenuti sugli argomenti che utilizzo e studio nel tempo.</p>
            <a class="text-link" href="/profilo/">Scopri il mio profilo →</a>
          </div>
        </div>
      </section>

      <section class="gl-section">
        <div class="gl-wrap">
          <div class="section-head">
            <div><p class="gl-eyebrow">Aree tecniche</p><h2>I temi su cui lavoro e pubblico.</h2></div>
            <p>Ogni area è anche un percorso editoriale con articoli, note tecniche e approfondimenti.</p>
          </div>
          <div class="topic-grid">
            <a href="/tags/wifi/"><span>01</span><h3>Wi-Fi</h3><p>Wireless enterprise, RF, roaming, site survey e troubleshooting.</p></a>
            <a href="/tags/networking/"><span>02</span><h3>Networking</h3><p>VLAN, infrastrutture, analisi del traffico e troubleshooting.</p></a>
            <a href="/tags/fortinet/"><span>03</span><h3>Fortinet</h3><p>FortiGate, VPN, policy, sicurezza e troubleshooting.</p></a>
            <a href="/tags/voip/"><span>04</span><h3>VoIP</h3><p>SIP, call flow, integrazioni e comunicazioni IP.</p></a>
            <a href="/tags/audiocodes/"><span>05</span><h3>AudioCodes</h3><p>SBC, routing SIP, manipolazioni e interoperabilità.</p></a>
          </div>
        </div>
      </section>

      <LatestArticles />

      <section class="knowledge-section">
        <div class="gl-wrap knowledge-grid">
          <div>
            <p class="gl-eyebrow">Knowledge Hub</p>
            <h2>Articoli, appunti e approfondimenti tecnici.</h2>
            <p>La parte editoriale del sito crescerà nel tempo e raccoglierà ciò che studio, sperimento e considero utile documentare.</p>
          </div>
          <a class="gl-button white-button" href="/posts/">Vai agli articoli →</a>
        </div>
      </section>

      <section id="stack" class="gl-section gl-section-white">
        <div class="gl-wrap split">
          <div><p class="gl-eyebrow">Technology stack</p><h2>Tecnologie e strumenti.</h2></div>
          <div class="stack-list">
            <span>FortiGate</span><span>Fortinet</span><span>AudioCodes SBC</span><span>Ekahau</span>
            <span>SIP</span><span>VoIP</span><span>VLAN</span><span>IPsec</span><span>Wireshark</span>
            <span>Microsoft Teams</span><span>Enterprise Wi-Fi</span><span>Wi-Fi</span><span>Survey Wi-Fi</span>
            <span>Analisi Wi-Fi</span><span>Site Survey</span>
          </div>
        </div>
      </section>
    </main>

    <PersonalFooter />
  </div>
</Layout>

<style>
  .home-hero { padding-top: 110px; padding-bottom: 95px; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 80px; align-items: center; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .identity-card { padding: 28px; border-radius: 24px; background: #0b1220; color: #fff; box-shadow: 0 30px 70px rgba(16,24,40,.16); }
  .identity-top { display: flex; justify-content: space-between; padding-bottom: 28px; border-bottom: 1px solid #243047; color: #60a5fa; font-family: monospace; font-size: 12px; }
  .identity-top small { color: #86efac; letter-spacing: .12em; }
  .identity-main { display: flex; align-items: center; gap: 18px; padding: 32px 0; }
  .avatar { width: 64px; height: 64px; display: grid; place-items: center; background: #1d4ed8; border-radius: 16px; font-size: 20px; font-weight: 800; }
  .identity-main h2 { margin: 0; font-size: 22px; }
  .identity-main p { margin: 6px 0 0; color: #94a3b8; }
  .identity-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .identity-tags span { padding: 8px 10px; border: 1px solid #2b3850; border-radius: 8px; color: #cbd5e1; font-size: 12px; }
  .split { display: grid; grid-template-columns: .8fr 1.2fr; gap: 100px; }
  .split h2, .section-head h2, .knowledge-section h2 { margin: 0; color: #0b1220; font-size: clamp(2.3rem,4vw,3.8rem); line-height: 1.05; letter-spacing: -.055em; }
  .copy p { color: #667085; line-height: 1.8; }
  .copy .large { margin-top: 0; color: #101828; font-size: 22px; line-height: 1.5; }
  .text-link { display: inline-block; margin-top: 18px; color: #2563eb; text-decoration: none; font-weight: 750; }
  .section-head { display: grid; grid-template-columns: 1fr .75fr; gap: 80px; align-items: end; margin-bottom: 48px; }
  .section-head > p { margin: 0; color: #667085; line-height: 1.75; }
  .topic-grid { display: grid; grid-template-columns: repeat(5,1fr); border-top: 1px solid #e4e7ec; border-left: 1px solid #e4e7ec; }
  .topic-grid a { min-height: 260px; padding: 28px; background: #fff; border-right: 1px solid #e4e7ec; border-bottom: 1px solid #e4e7ec; color: inherit; text-decoration: none; }
  .topic-grid a > span { color: #2563eb; font-family: monospace; font-size: 12px; }
  .topic-grid h3 { margin: 42px 0 12px; color: #0b1220; font-size: 22px; }
  .topic-grid p { margin: 0; color: #667085; font-size: 14px; line-height: 1.65; }
  .topic-grid a:hover h3 { color: #2563eb; }
  .knowledge-section { padding: 105px 0; background: #0b1220; color: #fff; }
  .knowledge-grid { display: grid; grid-template-columns: 1fr auto; gap: 60px; align-items: end; }
  .knowledge-section h2 { color: #fff; }
  .knowledge-section p:not(.gl-eyebrow) { max-width: 720px; color: #94a3b8; line-height: 1.75; }
  .white-button { background: #fff; color: #0b1220; }
  .stack-list { display: flex; flex-wrap: wrap; gap: 10px; }
  .stack-list span { padding: 10px 13px; border: 1px solid #e4e7ec; background: #f7f9fc; border-radius: 8px; color: #344054; font-family: monospace; font-size: 12px; }
  @media(max-width:950px){.hero-grid,.split,.section-head,.knowledge-grid{grid-template-columns:1fr;gap:45px}.topic-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:650px){.home-hero{padding-top:70px}.hero-actions{flex-direction:column}.topic-grid{grid-template-columns:1fr}.topic-grid a{min-height:auto}}
</style>