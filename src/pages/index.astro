---
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import LatestArticles from "@/components/LatestArticles.astro";
---

<Layout
  title="Giulio Lattanzio | Network & Security Specialist"
  description="Portfolio personale e raccolta di contenuti tecnici su networking, Wi-Fi, VoIP, Fortinet e AudioCodes."
>
  <div class="gl-shell">
    <PersonalHeader active="home" />

    <main>
      <section class="gl-section home-hero">
        <div class="gl-wrap hero-grid">
          <div>
            <p class="gl-eyebrow">Personal tech portfolio</p>
            <h1 class="gl-title">Networking, sicurezza e comunicazioni <span>raccontati attraverso esperienza e contenuti tecnici.</span></h1>
            <p class="gl-lead">
              Sono Giulio Lattanzio, Network & Security Specialist. Questo sito è la mia vetrina professionale:
              racconta chi sono, di cosa mi occupo, le tecnologie con cui lavoro e gli articoli che pubblico su Wi-Fi,
              networking, Fortinet, VoIP e AudioCodes.
            </p>
            <div class="hero-actions">
              <a class="gl-button gl-button-primary" href="/profilo/">Chi sono e cosa faccio</a>
              <a class="gl-button gl-button-secondary" href="/posts/">Leggi gli articoli</a>
            </div>
          </div>

          <figure class="hero-portrait">
            <img
              src="/images/profile/giulio%20lattanzio.png"
              alt="Ritratto di Giulio Lattanzio"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        </div>
      </section>

      <section class="gl-section gl-section-white">
        <div class="gl-wrap split">
          <div>
            <p class="gl-eyebrow">Profilo</p>
            <h2>Una presentazione di chi sono e di cosa mi occupo.</h2>
          </div>
          <div class="copy">
            <p class="large">Mi occupo di infrastrutture di rete, sicurezza, wireless enterprise e sistemi di comunicazione VoIP.</p>
            <p>Questo spazio non nasce per offrire servizi o consulenza: è una vetrina personale e professionale dove presento le aree tecniche su cui lavoro e raccolgo contenuti sugli argomenti che utilizzo e studio nel tempo.</p>
            <a class="text-link" href="/profilo/">Scopri il mio profilo →</a>
          </div>
        </div>
      </section>

      <section class="gl-section">
        <div class="gl-wrap">
          <div class="section-head">
            <div><p class="gl-eyebrow">Aree tecniche</p><h2>I temi su cui lavoro e pubblico.</h2></div>
            <p>Ogni area è anche un percorso editoriale con articoli, note tecniche e approfondimenti.</p>
          </div>
          <div class="topic-grid">
            <a href="/tags/wifi/"><span>01</span><h3>Wi-Fi</h3><p>Wireless enterprise, RF, roaming, site survey e troubleshooting.</p></a>
            <a href="/tags/networking/"><span>02</span><h3>Networking</h3><p>VLAN, infrastrutture, analisi del traffico e troubleshooting.</p></a>
            <a href="/tags/fortinet/"><span>03</span><h3>Fortinet</h3><p>FortiGate, VPN, policy, sicurezza e troubleshooting.</p></a>
            <a href="/tags/voip/"><span>04</span><h3>VoIP</h3><p>SIP, call flow, integrazioni e comunicazioni IP.</p></a>
            <a href="/tags/audiocodes/"><span>05</span><h3>AudioCodes</h3><p>SBC, routing SIP, manipolazioni e interoperabilità.</p></a>
          </div>
        </div>
      </section>

      <LatestArticles />

      <section class="knowledge-section">
        <div class="gl-wrap knowledge-grid">
          <div>
            <p class="gl-eyebrow">Knowledge Hub</p>
            <h2>Articoli, appunti e approfondimenti tecnici.</h2>
            <p>La parte editoriale del sito crescerà nel tempo e raccoglierà ciò che studio, sperimento e considero utile documentare.</p>
          </div>
          <a class="gl-button white-button" href="/posts/">Vai agli articoli →</a>
        </div>
      </section>

      <section id="stack" class="tech-section">
        <div class="gl-wrap">
          <div class="tech-intro">
            <div>
              <p class="gl-eyebrow">Technology stack</p>
              <h2>Tecnologie e strumenti che utilizzo nel mio lavoro.</h2>
            </div>
            <p>
              Il Wi-Fi è il focus principale del mio percorso tecnico, affiancato da networking, sicurezza,
              comunicazioni IP e strumenti di analisi utilizzati nelle attività quotidiane.
            </p>
          </div>

          <div class="tech-grid">
            <article class="tech-card tech-card-accent">
              <div class="tech-card-head">
                <span class="tech-index">01</span>
                <span class="tech-domain">Wireless Engineering</span>
              </div>
              <h3>Wi-Fi & RF</h3>
              <p>Analisi radio, progettazione, validazione sul campo e troubleshooting di reti wireless enterprise.</p>
              <div class="tech-tags" aria-label="Tecnologie wireless">
                <span>Ekahau</span>
                <span>Enterprise Wi-Fi</span>
                <span>Site Survey</span>
                <span>Survey Wi-Fi</span>
                <span>Analisi Wi-Fi</span>
              </div>
            </article>

            <article class="tech-card">
              <div class="tech-card-head">
                <span class="tech-index">02</span>
                <span class="tech-domain">Security & Networking</span>
              </div>
              <h3>Infrastruttura e sicurezza</h3>
              <p>Gestione e analisi di reti IP, segmentazione, connettività sicura e protezione perimetrale.</p>
              <div class="tech-tags" aria-label="Tecnologie infrastruttura e sicurezza">
                <span>FortiGate</span>
                <span>Fortinet</span>
                <span>VLAN</span>
                <span>IPsec</span>
              </div>
            </article>

            <article class="tech-card">
              <div class="tech-card-head">
                <span class="tech-index">03</span>
                <span class="tech-domain">Voice & Unified Communications</span>
              </div>
              <h3>VoIP & comunicazioni IP</h3>
              <p>Interoperabilità SIP, gestione SBC, call flow e integrazione tra piattaforme di comunicazione.</p>
              <div class="tech-tags" aria-label="Tecnologie voce e comunicazione">
                <span>AudioCodes SBC</span>
                <span>SIP</span>
                <span>VoIP</span>
                <span>Microsoft Teams</span>
              </div>
            </article>

            <article class="tech-card tech-card-accent">
              <div class="tech-card-head">
                <span class="tech-index">04</span>
                <span class="tech-domain">Analysis & Troubleshooting</span>
              </div>
              <h3>Diagnostica e analisi</h3>
              <p>Osservazione del traffico, verifica dei flussi e analisi tecnica dei problemi di rete e comunicazione.</p>
              <div class="tech-tags" aria-label="Strumenti di analisi">
                <span>Wireshark</span>
                <span>Packet Analysis</span>
                <span>Troubleshooting</span>
              </div>
            </article>
          </div>
        </div>
      </section>
    </main>

    <PersonalFooter />
  </div>
</Layout>

<style>
  .home-hero { padding-top: 110px; padding-bottom: 95px; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 80px; align-items: center; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .hero-portrait {
    width: min(100%, 420px);
    aspect-ratio: 4 / 5;
    margin: 0;
    justify-self: end;
    overflow: hidden;
    border: 1px solid #e4e7ec;
    border-radius: 28px;
    background: #e9edf3;
    box-shadow: 0 30px 70px rgba(16, 24, 40, .14);
  }

  .hero-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .split { display: grid; grid-template-columns: .8fr 1.2fr; gap: 100px; }
  .split h2, .section-head h2, .knowledge-section h2 { margin: 0; color: #0b1220; font-size: clamp(2.3rem,4vw,3.8rem); line-height: 1.05; letter-spacing: -.055em; }
  .copy p { color: #667085; line-height: 1.8; }
  .copy .large { margin-top: 0; color: #101828; font-size: 22px; line-height: 1.5; }
  .text-link { display: inline-block; margin-top: 18px; color: #2563eb; text-decoration: none; font-weight: 750; }
  .section-head { display: grid; grid-template-columns: 1fr .75fr; gap: 80px; align-items: end; margin-bottom: 48px; }
  .section-head > p { margin: 0; color: #667085; line-height: 1.75; }
  .topic-grid { display: grid; grid-template-columns: repeat(5,1fr); border-top: 1px solid #e4e7ec; border-left: 1px solid #e4e7ec; }
  .topic-grid a { min-height: 260px; padding: 28px; background: #fff; border-right: 1px solid #e4e7ec; border-bottom: 1px solid #e4e7ec; color: inherit; text-decoration: none; }
  .topic-grid a > span { color: #2563eb; font-family: monospace; font-size: 12px; }
  .topic-grid h3 { margin: 42px 0 12px; color: #0b1220; font-size: 22px; }
  .topic-grid p { margin: 0; color: #667085; font-size: 14px; line-height: 1.65; }
  .topic-grid a:hover h3 { color: #2563eb; }
  .knowledge-section { padding: 105px 0; background: #0b1220; color: #fff; }
  .knowledge-grid { display: grid; grid-template-columns: 1fr auto; gap: 60px; align-items: end; }
  .knowledge-section h2 { color: #fff; }
  .knowledge-section p:not(.gl-eyebrow) { max-width: 720px; color: #94a3b8; line-height: 1.75; }
  .white-button { background: #fff; color: #0b1220; }

  .tech-section {
    padding: 110px 0 120px;
    background:
      radial-gradient(circle at 88% 12%, rgba(37, 99, 235, .08), transparent 28%),
      #f7f9fc;
    border-top: 1px solid #e4e7ec;
  }

  .tech-intro {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 90px;
    align-items: end;
    margin-bottom: 50px;
  }

  .tech-intro h2 {
    max-width: 640px;
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.5rem, 4.5vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -.058em;
  }

  .tech-intro > p {
    max-width: 560px;
    margin: 0;
    color: #667085;
    font-size: 16px;
    line-height: 1.8;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .tech-card {
    position: relative;
    min-height: 300px;
    padding: 30px;
    overflow: hidden;
    background: rgba(255,255,255,.92);
    border: 1px solid #e4e7ec;
    border-radius: 22px;
    box-shadow: 0 14px 34px rgba(16, 24, 40, .045);
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
  }

  .tech-card::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #2563eb, #93c5fd 55%, transparent);
    opacity: .8;
  }

  .tech-card:hover {
    transform: translateY(-4px);
    border-color: #bfdbfe;
    box-shadow: 0 22px 50px rgba(16, 24, 40, .08);
  }

  .tech-card-accent {
    background: linear-gradient(135deg, #123b80 0%, #174ea6 58%, #2563eb 100%);
    border-color: #174ea6;
    box-shadow: 0 20px 50px rgba(29, 78, 216, .20);
  }

  .tech-card-accent::before {
    background: linear-gradient(90deg, #bfdbfe, #60a5fa 55%, transparent);
  }

  .tech-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 44px;
  }

  .tech-index {
    display: inline-grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 9px;
    background: #eff6ff;
    color: #2563eb;
    font-family: monospace;
    font-size: 11px;
    font-weight: 700;
  }

  .tech-domain {
    color: #667085;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .tech-card h3 {
    margin: 0 0 12px;
    color: #0b1220;
    font-size: 25px;
    line-height: 1.2;
    letter-spacing: -.04em;
  }

  .tech-card > p {
    max-width: 560px;
    margin: 0 0 28px;
    color: #667085;
    font-size: 14px;
    line-height: 1.7;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-tags span {
    padding: 8px 10px;
    border: 1px solid #e4e7ec;
    border-radius: 8px;
    background: #f8fafc;
    color: #344054;
    font-family: monospace;
    font-size: 11px;
  }

  .tech-card-accent .tech-index {
    background: rgba(255,255,255,.14);
    color: #dbeafe;
  }

  .tech-card-accent .tech-domain,
  .tech-card-accent > p {
    color: #dbeafe;
  }

  .tech-card-accent h3 {
    color: #fff;
  }

  .tech-card-accent .tech-tags span {
    border-color: rgba(255,255,255,.22);
    background: rgba(8, 27, 65, .28);
    color: #eff6ff;
  }

  @media(max-width:950px){
    .hero-grid,.split,.section-head,.knowledge-grid,.tech-intro{grid-template-columns:1fr;gap:45px}
    .hero-portrait{justify-self:center;width:min(100%,390px)}
    .topic-grid{grid-template-columns:repeat(2,1fr)}
    .tech-grid{grid-template-columns:1fr}
    .tech-card{min-height:auto}
  }

  @media(max-width:650px){
    .home-hero{padding-top:70px}
    .hero-actions{flex-direction:column}
    .hero-portrait{width:min(88vw,360px);border-radius:22px}
    .topic-grid{grid-template-columns:1fr}
    .topic-grid a{min-height:auto}
    .tech-section{padding:80px 0}
    .tech-card{padding:24px;border-radius:18px}
    .tech-card-head{margin-bottom:32px}
  }
</style>