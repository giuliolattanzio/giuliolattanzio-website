---
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import LatestArticles from "@/components/LatestArticles.astro";
---

<Layout
  title="Giulio Lattanzio | Network & Security Specialist"
  description="Portfolio personale e raccolta di contenuti tecnici su networking, Wi-Fi, VoIP, Fortinet e AudioCodes."
>
  <div class="gl-shell">
    <PersonalHeader active="home" />

    <main>
      <section class="gl-section home-hero">
        <div class="gl-wrap hero-grid">
          <div>
            <p class="gl-eyebrow">Personal tech portfolio</p>
            <h1 class="gl-title">Networking, sicurezza e comunicazioni <span>raccontati attraverso esperienza e contenuti tecnici.</span></h1>
            <p class="gl-lead">
              Sono Giulio Lattanzio, Network & Security Specialist. Questo sito è la mia vetrina professionale:
              racconta chi sono, di cosa mi occupo, le tecnologie con cui lavoro e gli articoli che pubblico su Wi-Fi,
              networking, Fortinet, VoIP e AudioCodes.
            </p>
          </div>

          <figure class="hero-portrait">
            <img
              src="/images/profile/giulio%20lattanzio.png"
              alt="Ritratto di Giulio Lattanzio"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        </div>
      </section>

      <section class="gl-section gl-section-white">
        <div class="gl-wrap split">
          <div>
            <p class="gl-eyebrow">Profilo</p>
            <h2>Una presentazione di chi sono e di cosa mi occupo.</h2>
          </div>
          <div class="copy">
            <p class="large">Mi occupo di infrastrutture di rete, sicurezza, wireless enterprise e sistemi di comunicazione VoIP.</p>
            <p>Questo spazio non nasce per offrire servizi o consulenza: è una vetrina personale e professionale dove presento le aree tecniche su cui lavoro e raccolgo contenuti sugli argomenti che utilizzo e studio nel tempo.</p>
            <a class="text-link" href="/profilo/">Scopri il mio profilo →</a>
          </div>
        </div>
      </section>

      <section class="areas-section">
        <div class="gl-wrap">
          <div class="section-head areas-head">
            <div>
              <p class="gl-eyebrow">Aree tecniche</p>
              <h2>I temi su cui lavoro e pubblico.</h2>
            </div>
            <p>
              Il Wi-Fi rappresenta il focus principale del mio percorso, affiancato da networking,
              sicurezza e comunicazioni IP.
            </p>
          </div>

          <div class="areas-grid">
            <a class="area-card area-card-featured" href="/tags/wifi/">
              <div class="area-card-top">
                <span class="area-label">Focus principale</span>
                <span class="area-arrow" aria-hidden="true">↗</span>
              </div>
              <div class="area-card-copy">
                <p class="area-domain">Wireless Engineering</p>
                <h3>Wi-Fi & RF</h3>
                <p>Wireless enterprise, progettazione RF, roaming, Ekahau, site survey, validazione e troubleshooting.</p>
              </div>
              <div class="area-tags" aria-label="Temi Wi-Fi">
                <span>Ekahau</span>
                <span>Site Survey</span>
                <span>Analisi Wi-Fi</span>
              </div>
            </a>

            <a class="area-card" href="/tags/networking/">
              <div class="area-card-top">
                <span class="area-domain">Infrastructure</span>
                <span class="area-arrow" aria-hidden="true">↗</span>
              </div>
              <h3>Networking</h3>
              <p>Reti IP, VLAN, architetture, analisi del traffico e troubleshooting dell'infrastruttura.</p>
            </a>

            <a class="area-card" href="/tags/fortinet/">
              <div class="area-card-top">
                <span class="area-domain">Security</span>
                <span class="area-arrow" aria-hidden="true">↗</span>
              </div>
              <h3>Fortinet</h3>
              <p>FortiGate, VPN, policy, segmentazione e sicurezza delle reti aziendali.</p>
            </a>

            <a class="area-card" href="/tags/voip/">
              <div class="area-card-top">
                <span class="area-domain">Voice over IP</span>
                <span class="area-arrow" aria-hidden="true">↗</span>
              </div>
              <h3>VoIP & SIP</h3>
              <p>Call flow, routing SIP, interoperabilità e analisi delle comunicazioni IP.</p>
            </a>

            <a class="area-card" href="/tags/audiocodes/">
              <div class="area-card-top">
                <span class="area-domain">Unified Communications</span>
                <span class="area-arrow" aria-hidden="true">↗</span>
              </div>
              <h3>AudioCodes</h3>
              <p>SBC, routing SIP, manipolazioni e integrazione con piattaforme di comunicazione.</p>
            </a>
          </div>
        </div>
      </section>

      <LatestArticles />

      <section class="knowledge-section">
        <div class="gl-wrap knowledge-grid">
          <div>
            <p class="gl-eyebrow">Knowledge Hub</p>
            <h2>Articoli, appunti e approfondimenti tecnici.</h2>
            <p>La parte editoriale del sito crescerà nel tempo e raccoglierà ciò che studio, sperimento e considero utile documentare.</p>
          </div>
          <a class="gl-button white-button" href="/posts/">Vai agli articoli →</a>
        </div>
      </section>

      <section id="stack" class="tech-section">
        <div class="gl-wrap">
          <div class="tech-intro">
            <div>
              <p class="gl-eyebrow">Technology stack</p>
              <h2>Tecnologie e strumenti che utilizzo nel mio lavoro.</h2>
            </div>
            <p>
              Il Wi-Fi è il focus principale del mio percorso tecnico, affiancato da networking, sicurezza,
              comunicazioni IP e strumenti di analisi utilizzati nelle attività quotidiane.
            </p>
          </div>

          <div class="tech-grid">
            <article class="tech-card tech-card-accent">
              <div class="tech-card-head">
                <span class="tech-domain">Wireless Engineering</span>
              </div>
              <h3>Wi-Fi & RF</h3>
              <p>Analisi radio, progettazione, validazione sul campo e troubleshooting di reti wireless enterprise.</p>
              <div class="tech-tags" aria-label="Tecnologie wireless">
                <span>Ekahau</span>
                <span>Enterprise Wi-Fi</span>
                <span>Site Survey</span>
                <span>Survey Wi-Fi</span>
                <span>Analisi Wi-Fi</span>
              </div>
            </article>

            <article class="tech-card">
              <div class="tech-card-head">
                <span class="tech-domain">Security & Networking</span>
              </div>
              <h3>Infrastruttura e sicurezza</h3>
              <p>Gestione e analisi di reti IP, segmentazione, connettività sicura e protezione perimetrale.</p>
              <div class="tech-tags" aria-label="Tecnologie infrastruttura e sicurezza">
                <span>FortiGate</span>
                <span>Fortinet</span>
                <span>VLAN</span>
                <span>IPsec</span>
              </div>
            </article>

            <article class="tech-card">
              <div class="tech-card-head">
                <span class="tech-domain">Voice & Unified Communications</span>
              </div>
              <h3>VoIP & comunicazioni IP</h3>
              <p>Interoperabilità SIP, gestione SBC, call flow e integrazione tra piattaforme di comunicazione.</p>
              <div class="tech-tags" aria-label="Tecnologie voce e comunicazione">
                <span>AudioCodes SBC</span>
                <span>SIP</span>
                <span>VoIP</span>
                <span>Microsoft Teams</span>
              </div>
            </article>

            <article class="tech-card tech-card-accent">
              <div class="tech-card-head">
                <span class="tech-domain">Analysis & Troubleshooting</span>
              </div>
              <h3>Diagnostica e analisi</h3>
              <p>Osservazione del traffico, verifica dei flussi e analisi tecnica dei problemi di rete e comunicazione.</p>
              <div class="tech-tags" aria-label="Strumenti di analisi">
                <span>Wireshark</span>
                <span>Packet Analysis</span>
                <span>Troubleshooting</span>
              </div>
            </article>
          </div>
        </div>
      </section>
    </main>

    <PersonalFooter />
  </div>
</Layout>

<style>
  .home-hero {
    padding-top: 110px;
    padding-bottom: 105px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: 80px;
    align-items: center;
  }

  .hero-portrait {
    width: min(100%, 420px);
    aspect-ratio: 4 / 5;
    margin: 0;
    justify-self: end;
    overflow: hidden;
    border: 1px solid rgba(11,18,32,.12);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 30px 70px rgba(11,18,32,.12);
  }

  .hero-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .split {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 100px;
  }

  .split h2,
  .section-head h2,
  .knowledge-section h2 {
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.3rem,4vw,3.8rem);
    line-height: 1.05;
    letter-spacing: -.055em;
  }

  .copy p {
    color: rgba(11,18,32,.66);
    line-height: 1.8;
  }

  .copy .large {
    margin-top: 0;
    color: #0b1220;
    font-size: 22px;
    line-height: 1.5;
  }

  .text-link {
    display: inline-block;
    margin-top: 18px;
    color: #2563eb;
    text-decoration: none;
    font-weight: 750;
  }

  .areas-section {
    padding: 110px 0 120px;
    background: #fff;
    border-top: 1px solid rgba(11,18,32,.1);
  }

  .section-head {
    display: grid;
    grid-template-columns: 1fr .75fr;
    gap: 80px;
    align-items: end;
    margin-bottom: 50px;
  }

  .section-head > p {
    margin: 0;
    color: rgba(11,18,32,.64);
    line-height: 1.75;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: 1.08fr .92fr .92fr;
    grid-template-rows: repeat(2, minmax(230px, auto));
    gap: 16px;
  }

  .area-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 28px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(11,18,32,.12);
    border-radius: 22px;
    color: #0b1220;
    text-decoration: none;
    box-shadow: 0 14px 34px rgba(11,18,32,.035);
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
  }

  .area-card:hover {
    transform: translateY(-4px);
    border-color: rgba(37,99,235,.45);
    box-shadow: 0 22px 50px rgba(11,18,32,.08);
  }

  .area-card-featured {
    grid-row: 1 / 3;
    padding: 34px;
    background: #2563eb;
    border-color: #2563eb;
    color: #fff;
    box-shadow: 0 24px 56px rgba(37,99,235,.18);
  }

  .area-card-featured:hover {
    border-color: #2563eb;
    box-shadow: 0 28px 64px rgba(37,99,235,.24);
  }

  .area-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .area-domain,
  .area-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .area-domain {
    color: rgba(11,18,32,.56);
  }

  .area-label {
    padding: 7px 10px;
    border: 1px solid rgba(255,255,255,.32);
    border-radius: 999px;
    color: #fff;
  }

  .area-arrow {
    color: #2563eb;
    font-size: 21px;
    line-height: 1;
  }

  .area-card-featured .area-arrow,
  .area-card-featured .area-domain {
    color: #fff;
  }

  .area-card-copy {
    margin-top: auto;
  }

  .area-card h3 {
    margin: 42px 0 12px;
    color: #0b1220;
    font-size: 25px;
    line-height: 1.15;
    letter-spacing: -.04em;
  }

  .area-card-featured h3 {
    margin-top: 18px;
    color: #fff;
    font-size: clamp(2.7rem,4vw,4.1rem);
    letter-spacing: -.055em;
  }

  .area-card p {
    margin: 0;
    color: rgba(11,18,32,.64);
    font-size: 14px;
    line-height: 1.7;
  }

  .area-card-featured p {
    max-width: 510px;
    color: rgba(255,255,255,.86);
    font-size: 15px;
  }

  .area-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 30px;
  }

  .area-tags span {
    padding: 8px 10px;
    border: 1px solid rgba(255,255,255,.28);
    border-radius: 8px;
    color: #fff;
    font-family: monospace;
    font-size: 11px;
  }

  .knowledge-section {
    padding: 105px 0;
    background: #0b1220;
    color: #fff;
  }

  .knowledge-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: end;
  }

  .knowledge-section h2 {
    color: #fff;
  }

  .knowledge-section p:not(.gl-eyebrow) {
    max-width: 720px;
    color: rgba(255,255,255,.64);
    line-height: 1.75;
  }

  .white-button {
    background: #fff;
    color: #0b1220;
  }

  .tech-section {
    padding: 110px 0 120px;
    background: #fff;
    border-top: 1px solid rgba(11,18,32,.1);
  }

  .tech-intro {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 90px;
    align-items: end;
    margin-bottom: 50px;
  }

  .tech-intro h2 {
    max-width: 640px;
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.5rem, 4.5vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -.058em;
  }

  .tech-intro > p {
    max-width: 560px;
    margin: 0;
    color: rgba(11,18,32,.64);
    font-size: 16px;
    line-height: 1.8;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .tech-card {
    position: relative;
    min-height: 300px;
    padding: 30px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(11,18,32,.12);
    border-radius: 22px;
    box-shadow: 0 14px 34px rgba(11,18,32,.04);
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
  }

  .tech-card::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 3px;
    background: #2563eb;
  }

  .tech-card:hover {
    transform: translateY(-4px);
    border-color: rgba(37,99,235,.42);
    box-shadow: 0 22px 50px rgba(11,18,32,.08);
  }

  .tech-card-accent {
    background: #2563eb;
    border-color: #2563eb;
    box-shadow: 0 20px 50px rgba(37,99,235,.18);
  }

  .tech-card-accent::before {
    background: #2563eb;
  }

  .tech-card-head {
    display: flex;
    align-items: center;
    margin-bottom: 44px;
  }

  .tech-domain {
    color: rgba(11,18,32,.56);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .tech-card h3 {
    margin: 0 0 12px;
    color: #0b1220;
    font-size: 25px;
    line-height: 1.2;
    letter-spacing: -.04em;
  }

  .tech-card > p {
    max-width: 560px;
    margin: 0 0 28px;
    color: rgba(11,18,32,.64);
    font-size: 14px;
    line-height: 1.7;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-tags span {
    padding: 8px 10px;
    border: 1px solid rgba(11,18,32,.12);
    border-radius: 8px;
    background: #fff;
    color: #0b1220;
    font-family: monospace;
    font-size: 11px;
  }

  .tech-card-accent .tech-domain,
  .tech-card-accent > p,
  .tech-card-accent h3 {
    color: #fff;
  }

  .tech-card-accent > p {
    color: rgba(255,255,255,.84);
  }

  .tech-card-accent .tech-tags span {
    border-color: rgba(255,255,255,.28);
    background: transparent;
    color: #fff;
  }

  @media(max-width:1050px) {
    .areas-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }

    .area-card-featured {
      grid-column: 1 / 3;
      grid-row: auto;
      min-height: 390px;
    }
  }

  @media(max-width:950px) {
    .hero-grid,
    .split,
    .section-head,
    .knowledge-grid,
    .tech-intro {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .hero-portrait {
      justify-self: center;
      width: min(100%,390px);
    }

    .tech-grid {
      grid-template-columns: 1fr;
    }

    .tech-card {
      min-height: auto;
    }
  }

  @media(max-width:650px) {
    .home-hero {
      padding-top: 70px;
      padding-bottom: 78px;
    }

    .hero-portrait {
      width: min(88vw,360px);
      border-radius: 22px;
    }

    .areas-section,
    .tech-section {
      padding: 80px 0;
    }

    .areas-grid {
      grid-template-columns: 1fr;
    }

    .area-card-featured {
      grid-column: auto;
      min-height: 380px;
    }

    .area-card,
    .tech-card {
      padding: 24px;
      border-radius: 18px;
    }

    .tech-card-head {
      margin-bottom: 32px;
    }
  }
</style>