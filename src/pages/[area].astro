---
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import LatestArticles from "@/components/LatestArticles.astro";
import WifiAuthority from "@/components/WifiAuthority.astro";
import { TECHNICAL_AREAS, type Area } from "@/data/technicalAreas";

export function getStaticPaths() {
  return TECHNICAL_AREAS.map(area => ({
    params: { area: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props as { area: Area };
const otherAreas = TECHNICAL_AREAS.filter(item => item.slug !== area.slug);
const isWifi = area.slug === "wifi";
const isNetworking = area.slug === "networking-security";
const isVoip = area.slug === "voip";
const pageTitle = isWifi
  ? "Tecnico Wi-Fi, Survey Wi-Fi & Wireless Engineering | Giulio Lattanzio"
  : `${area.title} | Giulio Lattanzio`;
const pageDescription = isWifi
  ? "Giulio Lattanzio è Network, Wi-Fi & VoIP Specialist con focus su Wi-Fi enterprise, survey Wi-Fi, site survey, Ekahau, RF design e troubleshooting wireless."
  : isNetworking
    ? "Networking e sicurezza: reti IP, switching, VLAN, routing, Fortinet/FortiGate, Alcatel, VPN, IPsec, Wireshark e troubleshooting di infrastruttura."
    : isVoip
      ? "VoIP e AudioCodes: SIP, call flow, SBC, call routing, message manipulations, Microsoft Teams, interoperabilità e troubleshooting delle comunicazioni IP."
      : area.description;

const areaDetail = area.slug === "networking-security"
  ? {
      eyebrow: "Infrastructure & Security",
      heading: "Dall'infrastruttura alla sicurezza operativa della rete.",
      intro:
        "Questa area collega architettura IP, switching e segmentazione alla protezione e all'analisi operativa: dalla gestione della rete con tecnologie Alcatel alla sicurezza Fortinet/FortiGate e al troubleshooting.",
      cards: [
        {
          eyebrow: "Network infrastructure",
          title: "Reti IP, VLAN & switching",
          description:
            "Architetture IP, switching, routing, segmentazione e VLAN per organizzare e gestire l'infrastruttura di rete, anche su tecnologie Alcatel.",
          tags: ["Networking", "Alcatel", "VLAN"],
        },
        {
          eyebrow: "Security",
          title: "Fortinet & FortiGate",
          description:
            "Policy, VPN, segmentazione, protezione perimetrale e gestione della sicurezza con tecnologie Fortinet e FortiGate.",
          tags: ["Fortinet", "FortiGate", "VPN"],
        },
        {
          eyebrow: "Analysis & troubleshooting",
          title: "Analisi & troubleshooting",
          description:
            "Osservazione del traffico, verifica dei flussi, packet analysis e diagnosi dei problemi che interessano rete e sicurezza.",
          tags: ["Wireshark", "Traffic Analysis", "Troubleshooting"],
        },
      ],
      topicsHeading: "Gli argomenti principali dell’area Networking & Security.",
      topicsIntro:
        "Dalle infrastrutture IP alla segmentazione, dalla sicurezza Fortinet alla connettività VPN e all'analisi del traffico: i contenuti restano raccolti in un unico hub, mentre articoli e tag consentono di approfondire i singoli temi.",
      topics: [
        {
          title: "Reti IP & switching",
          description:
            "Architetture, indirizzamento, switching, routing e gestione operativa delle infrastrutture, incluse piattaforme Alcatel.",
        },
        {
          title: "VLAN & segmentazione",
          description:
            "Separazione logica delle reti, organizzazione dei domini e criteri di segmentazione dell'infrastruttura.",
        },
        {
          title: "Fortinet & FortiGate",
          description:
            "Configurazione, policy e utilizzo delle piattaforme Fortinet nella protezione delle reti aziendali.",
        },
        {
          title: "VPN & IPsec",
          description:
            "Connettività sicura, tunnel IPsec e scenari di accesso remoto o collegamento tra sedi.",
        },
        {
          title: "Analisi del traffico",
          description:
            "Lettura dei flussi, packet analysis e osservazione del comportamento reale della rete attraverso strumenti come Wireshark.",
        },
        {
          title: "Troubleshooting",
          description:
            "Metodo di analisi dei problemi attraverso verifiche, misure e correlazione delle informazioni disponibili.",
        },
      ],
    }
  : area.slug === "voip"
    ? {
        eyebrow: "Unified Communications",
        heading: "Dalla segnalazione SIP all'interoperabilità tra piattaforme.",
        intro:
          "Questa area raccoglie gli aspetti operativi delle comunicazioni VoIP: lettura dei flussi SIP, gestione degli SBC AudioCodes, call routing, normalizzazione della segnalazione, integrazione con Microsoft Teams e troubleshooting.",
        cards: [
          {
            eyebrow: "Voice over IP",
            title: "SIP & Call Flow",
            description:
              "Segnalazione SIP, lettura dei call flow e analisi dei messaggi per comprendere il comportamento delle chiamate e individuare eventuali anomalie.",
            tags: ["SIP", "Call Flow", "VoIP"],
          },
          {
            eyebrow: "Session Border Controller",
            title: "AudioCodes SBC",
            description:
              "Gestione degli SBC AudioCodes, call routing, normalizzazione e manipolazione della segnalazione negli scenari di comunicazione IP.",
            tags: ["AudioCodes", "SBC", "Routing"],
          },
          {
            eyebrow: "Integration & troubleshooting",
            title: "Interoperabilità & troubleshooting",
            description:
              "Integrazione tra piattaforme, Microsoft Teams, analisi end-to-end dei flussi e diagnosi dei problemi nelle comunicazioni VoIP.",
            tags: ["Microsoft Teams", "Interoperabilità", "Troubleshooting"],
          },
        ],
        topicsHeading: "Gli argomenti principali dell’area VoIP & AudioCodes.",
        topicsIntro:
          "Dalla segnalazione SIP agli SBC, dal routing alle integrazioni con Microsoft Teams: i contenuti approfondiscono il comportamento delle comunicazioni IP e gli strumenti utilizzati per analizzarle e gestirle.",
        topics: [
          {
            title: "SIP",
            description:
              "Segnalazione, messaggi, dialoghi e principi necessari per interpretare il comportamento di una chiamata IP.",
          },
          {
            title: "AudioCodes SBC",
            description:
              "Session Border Controller AudioCodes, configurazione, gestione e utilizzo negli scenari enterprise.",
          },
          {
            title: "Call Routing",
            description:
              "Regole di instradamento, manipolazione delle destinazioni e logiche che determinano il percorso delle chiamate.",
          },
          {
            title: "Message Manipulations",
            description:
              "Normalizzazione e modifica della segnalazione SIP per garantire compatibilità e interoperabilità tra sistemi differenti.",
          },
          {
            title: "Microsoft Teams",
            description:
              "Integrazione della telefonia con Teams e scenari di interoperabilità con infrastrutture e SBC AudioCodes.",
          },
          {
            title: "Troubleshooting VoIP",
            description:
              "Analisi dei call flow, individuazione degli errori e correlazione tra segnalazione, routing e comportamento della chiamata.",
          },
        ],
      }
    : null;
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="gl-shell">
    <PersonalHeader />

    <main>
      <section class="area-hero">
        <div class="gl-wrap area-hero-grid">
          <div>
            <a class="gl-back" href="/">← Home</a>
            <p class="gl-eyebrow">{area.eyebrow}</p>
            <h1 class="area-title">{area.title}</h1>
            <p class="area-lead">
              {isWifi
                ? "Progettazione, analisi e validazione di reti Wi-Fi enterprise: RF design, site survey, Ekahau e troubleshooting wireless."
                : isVoip
                  ? "SIP, call flow, SBC AudioCodes, routing, interoperabilità e troubleshooting delle comunicazioni VoIP e delle integrazioni con Microsoft Teams."
                  : area.description}
            </p>
          </div>

          {isWifi ? (
            <figure class="area-portrait">
              <img
                src="/images/profile/giulio-lattanzio-survey.PNG"
                alt="Giulio Lattanzio durante un'attività di site survey Wi-Fi"
                loading="eager"
                fetchpriority="high"
              />
            </figure>
          ) : (
            <aside class="area-summary">
              <span>Area tecnica</span>
              <p>{area.summary}</p>
              <div class="area-topic-list" aria-label={`Temi ${area.label}`}>
                {area.topics.map(topic => <span>{topic}</span>)}
              </div>
            </aside>
          )}
        </div>
      </section>

      {isWifi ? (
        <>
          <WifiAuthority />

          <section class="wifi-workflow">
            <div class="gl-wrap">
              <div class="wifi-section-head">
                <div>
                  <p class="gl-eyebrow">Wireless engineering</p>
                  <h2>Dal progetto alla validazione sul campo.</h2>
                </div>
                <p>
                  Questa area segue un percorso semplice: progettare la rete, misurarla sul campo e analizzarne il comportamento reale per validare prestazioni e individuare eventuali criticità.
                </p>
              </div>

              <div class="wifi-workflow-grid">
                <article class="wifi-work-card">
                  <span>Design & planning</span>
                  <h3>Progettazione RF</h3>
                  <p>Requisiti, copertura, capacità, posizionamento degli AP e criteri di progetto per reti Wi-Fi enterprise.</p>
                  <div class="wifi-card-tags">
                    <span>RF</span>
                    <span>Capacity</span>
                    <span>Enterprise Wi-Fi</span>
                  </div>
                </article>

                <article class="wifi-work-card">
                  <span>Survey & validation</span>
                  <h3>Site Survey</h3>
                  <p>Survey passive e attive, misurazioni sul campo, validazione post-deployment e analisi delle heatmap.</p>
                  <div class="wifi-card-tags">
                    <a href="/tags/site-survey/">Site Survey</a>
                    <a href="/tags/ekahau/">Ekahau</a>
                    <a href="/tags/analisi-wifi/">Analisi Wi-Fi</a>
                  </div>
                </article>

                <article class="wifi-work-card">
                  <span>Analysis & troubleshooting</span>
                  <h3>Analisi & Troubleshooting Wi-Fi</h3>
                  <p>Analisi di copertura, interferenze, roaming e prestazioni per comprendere il comportamento reale della WLAN e individuare le cause dei problemi.</p>
                  <div class="wifi-card-tags">
                    <span>Roaming</span>
                    <span>Spectrum</span>
                    <span>Troubleshooting</span>
                  </div>
                </article>
              </div>
            </div>
          </section>

          <section class="wifi-topics">
            <div class="gl-wrap">
              <div class="wifi-topics-head">
                <div>
                  <h2>Gli argomenti principali dell’area Wi-Fi.</h2>
                </div>
                <p>
                  Dalla radiofrequenza alla progettazione, dalle site survey al troubleshooting: i contenuti approfondiscono i diversi aspetti del wireless enterprise mantenendo una struttura editoriale semplice e coerente.
                </p>
              </div>

              <div class="wifi-topic-grid">
                <article>
                  <h3>Radio Frequency</h3>
                  <p>Copertura, SNR, interferenze, canali, potenza e principi che determinano il comportamento di una rete wireless.</p>
                </article>
                <article>
                  <h3>Wi-Fi Design</h3>
                  <p>Progettazione orientata ai requisiti, capacità, densità degli utenti e caratteristiche degli ambienti.</p>
                </article>
                <article>
                  <h3>Site Survey</h3>
                  <p>Metodologie di misura, survey passive e attive, raccolta dati e validazione delle reti installate.</p>
                </article>
                <article>
                  <h3>Ekahau</h3>
                  <p>Utilizzo degli strumenti di survey e progettazione per leggere, rappresentare e documentare l'ambiente RF.</p>
                </article>
                <article>
                  <h3>Roaming</h3>
                  <p>Comportamento dei client, transizione tra celle e fattori che influenzano continuità e qualità della connessione.</p>
                </article>
                <article>
                  <h3>Troubleshooting</h3>
                  <p>Approccio alla diagnosi dei problemi wireless attraverso misure, osservazione e correlazione dei dati raccolti.</p>
                </article>
              </div>
            </div>
          </section>
        </>
      ) : areaDetail ? (
        <>
          <section class="pillar-workflow">
            <div class="gl-wrap">
              <div class="pillar-section-head">
                <div>
                  <p class="gl-eyebrow">{areaDetail.eyebrow}</p>
                  <h2>{areaDetail.heading}</h2>
                </div>
                <p>{areaDetail.intro}</p>
              </div>

              <div class="pillar-workflow-grid">
                {areaDetail.cards.map(card => (
                  <article class="pillar-work-card">
                    <span>{card.eyebrow}</span>
                    <h3>{card.title}</h3>
                    <p>{card.description}</p>
                    <div class="pillar-card-tags">
                      {card.tags.map(tag => <span>{tag}</span>)}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <section class="pillar-topics">
            <div class="gl-wrap">
              <div class="pillar-topics-head">
                <div>
                  <h2>{areaDetail.topicsHeading}</h2>
                </div>
                <p>{areaDetail.topicsIntro}</p>
              </div>

              <div class="pillar-topic-grid">
                {areaDetail.topics.map(topic => (
                  <article>
                    <h3>{topic.title}</h3>
                    <p>{topic.description}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>
        </>
      ) : (
        <section class="area-content">
          <div class="gl-wrap area-content-grid">
            <div>
              <p class="gl-eyebrow">Sezione tematica</p>
              <h2>Uno spazio dedicato a {area.title}.</h2>
            </div>
            <div class="area-copy">
              <p>
                Questa pagina è il punto di accesso ai contenuti, agli strumenti e agli appunti che riguardano questa area tecnica.
                La struttura è già pronta per essere sviluppata progressivamente mantenendo una navigazione semplice e coerente.
              </p>
            </div>
          </div>
        </section>
      )}

      <LatestArticles
        tags={area.tags}
        eyebrow={isWifi || isNetworking || isVoip ? "Ultimi articoli" : "Ultimi contenuti"}
        heading={isWifi
          ? "Approfondimenti su Wi-Fi e wireless engineering."
          : isNetworking
            ? "Approfondimenti su networking e sicurezza."
            : isVoip
              ? "Approfondimenti su VoIP, SIP e AudioCodes."
              : `Dal Knowledge Hub: ${area.label}.`}
        archiveHref={area.archiveHref}
        archiveLabel={isWifi || isNetworking || isVoip ? "Tutti gli articoli →" : "Vai all’archivio completo →"}
        emptyText={`I contenuti dedicati a ${area.label} appariranno qui.`}
      />

      <section class="area-navigation">
        <div class="gl-wrap">
          <div class="area-navigation-head">
            <div>
              <p class="gl-eyebrow">Aree tecniche</p>
              <h2>Esplora le altre sezioni.</h2>
            </div>
            <a href="/">Torna alla panoramica →</a>
          </div>

          <div class="area-navigation-grid">
            {otherAreas.map(item => (
              <a class="area-navigation-card" href={`/${item.slug}/`}>
                <span>{item.eyebrow}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <strong>Apri la sezione →</strong>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <PersonalFooter />
  </div>
</Layout>

<style>
  .area-hero {
    padding: 100px 0 105px;
    background: #fff;
  }

  .area-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 90px;
    align-items: center;
  }

  .area-title {
    max-width: 720px;
    margin: 0;
    color: #0b1220;
    font-size: clamp(3.6rem, 7vw, 6.4rem);
    line-height: .96;
    letter-spacing: -.065em;
  }

  .area-lead {
    max-width: 720px;
    margin: 28px 0 0;
    color: rgba(11, 18, 32, .66);
    font-size: 19px;
    line-height: 1.75;
  }

  .area-portrait {
    width: min(100%, 445px);
    aspect-ratio: 4 / 5;
    margin: 0;
    justify-self: end;
    overflow: hidden;
    border: 1px solid rgba(11, 18, 32, .10);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 28px 68px rgba(11, 18, 32, .12);
  }

  .area-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .area-summary {
    padding: 34px;
    background: #0b1220;
    border-radius: 24px;
    color: #fff;
    box-shadow: 0 24px 58px rgba(11, 18, 32, .16);
  }

  .area-summary > span {
    color: #2563eb;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .area-summary > p {
    margin: 28px 0 0;
    color: rgba(255, 255, 255, .84);
    font-size: 17px;
    line-height: 1.7;
  }

  .area-topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 30px;
  }

  .area-topic-list span {
    padding: 8px 10px;
    border: 1px solid rgba(255, 255, 255, .24);
    border-radius: 8px;
    color: #fff;
    font-family: monospace;
    font-size: 11px;
  }

  .area-content,
  .wifi-workflow,
  .wifi-topics,
  .pillar-workflow,
  .pillar-topics,
  .area-navigation {
    position: relative;
  }

  .area-content {
    padding: 105px 0;
    background: #fff;
  }

  .area-content::before,
  .wifi-workflow::before,
  .wifi-topics::before,
  .pillar-workflow::before,
  .pillar-topics::before,
  .area-navigation::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: min(1160px, calc(100% - 40px));
    height: 1px;
    transform: translateX(-50%);
    background: rgba(11, 18, 32, .10);
  }

  .area-content-grid {
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: 100px;
  }

  .area-content h2,
  .area-navigation-head h2,
  .wifi-section-head h2,
  .wifi-topics-head h2,
  .pillar-section-head h2,
  .pillar-topics-head h2 {
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.5rem, 4.5vw, 4rem);
    line-height: 1.03;
    letter-spacing: -.055em;
  }

  .area-copy p {
    max-width: 680px;
    margin: 0;
    color: rgba(11, 18, 32, .66);
    font-size: 17px;
    line-height: 1.8;
  }

  .wifi-workflow,
  .pillar-workflow {
    padding: 105px 0 115px;
    background: #fff;
  }

  .wifi-section-head,
  .wifi-topics-head,
  .pillar-section-head,
  .pillar-topics-head {
    display: grid;
    grid-template-columns: 1fr .85fr;
    gap: 90px;
    align-items: end;
    margin-bottom: 46px;
  }

  .wifi-section-head > p,
  .wifi-topics-head > p,
  .pillar-section-head > p,
  .pillar-topics-head > p {
    margin: 0;
    color: rgba(11, 18, 32, .64);
    font-size: 16px;
    line-height: 1.8;
  }

  .wifi-workflow-grid,
  .pillar-workflow-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .wifi-work-card,
  .pillar-work-card {
    display: flex;
    min-height: 350px;
    flex-direction: column;
    padding: 30px;
    border: 1px solid rgba(11, 18, 32, .12);
    border-radius: 22px;
    background: #fff;
    color: #0b1220;
    box-shadow: 0 14px 34px rgba(11, 18, 32, .035);
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }

  .wifi-work-card:hover,
  .pillar-work-card:hover {
    transform: translateY(-3px);
    border-color: rgba(11, 18, 32, .24);
    box-shadow: 0 20px 44px rgba(11, 18, 32, .07);
  }

  .wifi-work-card > span,
  .pillar-work-card > span {
    color: #2563eb;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .wifi-work-card h3,
  .pillar-work-card h3 {
    margin: 72px 0 14px;
    font-size: 29px;
    line-height: 1.15;
    letter-spacing: -.045em;
  }

  .wifi-work-card p,
  .pillar-work-card p {
    margin: 0;
    color: rgba(11, 18, 32, .64);
    font-size: 14px;
    line-height: 1.75;
  }

  .wifi-card-tags,
  .pillar-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 28px;
  }

  .wifi-card-tags span,
  .wifi-card-tags a,
  .pillar-card-tags span {
    padding: 8px 10px;
    border: 1px solid rgba(11, 18, 32, .12);
    border-radius: 8px;
    color: #0b1220;
    font-family: monospace;
    font-size: 11px;
    text-decoration: none;
  }

  .wifi-card-tags a:hover {
    color: #2563eb;
  }

  .wifi-topics,
  .pillar-topics {
    padding: 105px 0 115px;
    background: #0b1220;
    color: #fff;
  }

  .wifi-topics::before,
  .pillar-topics::before {
    background: rgba(255, 255, 255, .10);
  }

  .wifi-topics-head h2,
  .pillar-topics-head h2 {
    color: #fff;
  }

  .wifi-topics-head > p,
  .pillar-topics-head > p {
    color: rgba(255, 255, 255, .64);
  }

  .wifi-topic-grid,
  .pillar-topic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, .14);
    border-left: 1px solid rgba(255, 255, 255, .14);
  }

  .wifi-topic-grid article,
  .pillar-topic-grid article {
    min-height: 215px;
    padding: 30px 28px;
    border-right: 1px solid rgba(255, 255, 255, .14);
    border-bottom: 1px solid rgba(255, 255, 255, .14);
  }

  .wifi-topic-grid h3,
  .pillar-topic-grid h3 {
    margin: 0 0 16px;
    color: #fff;
    font-size: 25px;
    line-height: 1.15;
    letter-spacing: -.04em;
  }

  .wifi-topic-grid p,
  .pillar-topic-grid p {
    margin: 0;
    color: rgba(255, 255, 255, .66);
    font-size: 14px;
    line-height: 1.72;
  }

  .area-navigation {
    padding: 95px 0 110px;
    background: #fff;
  }

  .area-navigation-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 38px;
  }

  .area-navigation-head > a {
    color: #2563eb;
    text-decoration: none;
    font-size: 14px;
    font-weight: 750;
    white-space: nowrap;
  }

  .area-navigation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .area-navigation-card {
