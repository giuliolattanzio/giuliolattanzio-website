---
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import LatestArticles from "@/components/LatestArticles.astro";
import { TECHNICAL_AREAS, type Area } from "@/data/technicalAreas";

export function getStaticPaths() {
  return TECHNICAL_AREAS.map(area => ({
    params: { area: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props as { area: Area };
const otherAreas = TECHNICAL_AREAS.filter(item => item.slug !== area.slug);
const isWifi = area.slug === "wifi";
---

<Layout
  title={`${area.title} | Giulio Lattanzio`}
  description={area.description}
>
  <div class="gl-shell">
    <PersonalHeader />

    <main>
      <section class="area-hero">
        <div class="gl-wrap area-hero-grid">
          <div>
            <a class="gl-back" href="/">← Home</a>
            <p class="gl-eyebrow">{area.eyebrow}</p>
            <h1 class="area-title">{area.title}</h1>
            <p class="area-lead">{area.description}</p>
          </div>

          <aside class="area-summary">
            <span>Area tecnica</span>
            <p>{area.summary}</p>
            <div class="area-topic-list" aria-label={`Temi ${area.label}`}>
              {area.topics.map(topic => <span>{topic}</span>)}
            </div>
          </aside>
        </div>
      </section>

      {isWifi ? (
        <>
          <section class="wifi-workflow">
            <div class="gl-wrap">
              <div class="wifi-section-head">
                <div>
                  <p class="gl-eyebrow">Wireless engineering</p>
                  <h2>Dal progetto alla validazione sul campo.</h2>
                </div>
                <p>
                  Organizzo questa area attorno alle fasi che considero più importanti nel lavoro su una WLAN:
                  progettare, misurare e verificare ciò che accade realmente nell'ambiente radio.
                </p>
              </div>

              <div class="wifi-workflow-grid">
                <article class="wifi-work-card wifi-work-card-dark">
                  <span>Design & planning</span>
                  <h3>Progettazione RF</h3>
                  <p>Requisiti, copertura, capacità, posizionamento degli AP e criteri di progetto per reti Wi-Fi enterprise.</p>
                  <div class="wifi-card-tags">
                    <span>RF</span>
                    <span>Capacity</span>
                    <span>Enterprise Wi-Fi</span>
                  </div>
                </article>

                <article class="wifi-work-card">
                  <span>Survey & validation</span>
                  <h3>Site Survey</h3>
                  <p>Survey passive e attive, misurazioni sul campo, validazione post-deployment e analisi delle heatmap.</p>
                  <div class="wifi-card-tags wifi-card-tags-light">
                    <a href="/tags/site-survey/">Site Survey</a>
                    <a href="/tags/ekahau/">Ekahau</a>
                    <a href="/tags/analisi-wifi/">Analisi Wi-Fi</a>
                  </div>
                </article>

                <article class="wifi-work-card">
                  <span>Analysis & troubleshooting</span>
                  <h3>Analisi Wi-Fi</h3>
                  <p>Copertura, interferenze, roaming, prestazioni e lettura dei dati per capire il comportamento reale della WLAN.</p>
                  <div class="wifi-card-tags wifi-card-tags-light">
                    <span>Roaming</span>
                    <span>Spectrum</span>
                    <span>Troubleshooting</span>
                  </div>
                </article>
              </div>
            </div>
          </section>

          <section class="wifi-topics">
            <div class="gl-wrap">
              <div class="wifi-topics-head">
                <div>
                  <p class="gl-eyebrow">Temi principali</p>
                  <h2>Gli argomenti che troveranno spazio in questa sezione.</h2>
                </div>
                <p>
                  Le categorie restano ampie; i tag e gli articoli permettono poi di scendere nel dettaglio senza frammentare la navigazione principale.
                </p>
              </div>

              <div class="wifi-topic-grid">
                <article>
                  <span>RF</span>
                  <h3>Radio Frequency</h3>
                  <p>Copertura, SNR, interferenze, canali, potenza e principi che determinano il comportamento di una rete wireless.</p>
                </article>
                <article>
                  <span>Design</span>
                  <h3>Wi-Fi Design</h3>
                  <p>Progettazione orientata ai requisiti, capacità, densità degli utenti e caratteristiche degli ambienti.</p>
                </article>
                <article>
                  <span>Survey</span>
                  <h3>Site Survey</h3>
                  <p>Metodologie di misura, survey passive e attive, raccolta dati e validazione delle reti installate.</p>
                </article>
                <article>
                  <span>Tools</span>
                  <h3>Ekahau</h3>
                  <p>Utilizzo degli strumenti di survey e progettazione per leggere, rappresentare e documentare l'ambiente RF.</p>
                </article>
                <article>
                  <span>Mobility</span>
                  <h3>Roaming</h3>
                  <p>Comportamento dei client, transizione tra celle e fattori che influenzano continuità e qualità della connessione.</p>
                </article>
                <article>
                  <span>Analysis</span>
                  <h3>Troubleshooting</h3>
                  <p>Approccio alla diagnosi dei problemi wireless attraverso misure, osservazione e correlazione dei dati raccolti.</p>
                </article>
              </div>
            </div>
          </section>
        </>
      ) : (
        <section class="area-content">
          <div class="gl-wrap area-content-grid">
            <div>
              <p class="gl-eyebrow">Sezione tematica</p>
              <h2>Uno spazio dedicato a {area.title}.</h2>
            </div>
            <div class="area-copy">
              <p>
                Questa pagina è il punto di accesso ai contenuti, agli strumenti e agli appunti che riguardano questa area tecnica.
                La struttura è già pronta per essere sviluppata progressivamente mantenendo una navigazione semplice e coerente.
              </p>
            </div>
          </div>
        </section>
      )}

      <LatestArticles
        tags={area.tags}
        eyebrow="Ultimi contenuti"
        heading={`Dal Knowledge Hub: ${area.label}.`}
        archiveHref={area.archiveHref}
        archiveLabel="Vai all’archivio completo →"
        emptyText={`I contenuti dedicati a ${area.label} appariranno qui.`}
      />

      <section class="area-navigation">
        <div class="gl-wrap">
          <div class="area-navigation-head">
            <div>
              <p class="gl-eyebrow">Aree tecniche</p>
              <h2>Esplora le altre sezioni.</h2>
            </div>
            <a href="/">Torna alla panoramica →</a>
          </div>

          <div class="area-navigation-grid">
            {otherAreas.map(item => (
              <a class="area-navigation-card" href={`/${item.slug}/`}>
                <span>{item.eyebrow}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <strong>Apri la sezione →</strong>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <PersonalFooter />
  </div>
</Layout>

<style>
  .area-hero {
    padding: 100px 0 105px;
    background: #fff;
  }

  .area-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 90px;
    align-items: center;
  }

  .area-title {
    max-width: 720px;
    margin: 0;
    color: #0b1220;
    font-size: clamp(3.6rem, 7vw, 6.4rem);
    line-height: .96;
    letter-spacing: -.065em;
  }

  .area-lead {
    max-width: 720px;
    margin: 28px 0 0;
    color: rgba(11, 18, 32, .66);
    font-size: 19px;
    line-height: 1.75;
  }

  .area-summary {
    padding: 34px;
    background: #0b1220;
    border-radius: 24px;
    color: #fff;
    box-shadow: 0 24px 58px rgba(11, 18, 32, .16);
  }

  .area-summary > span {
    color: #2563eb;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .area-summary > p {
    margin: 28px 0 0;
    color: rgba(255, 255, 255, .84);
    font-size: 17px;
    line-height: 1.7;
  }

  .area-topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 30px;
  }

  .area-topic-list span {
    padding: 8px 10px;
    border: 1px solid rgba(255, 255, 255, .24);
    border-radius: 8px;
    color: #fff;
    font-family: monospace;
    font-size: 11px;
  }

  .area-content,
  .wifi-workflow,
  .wifi-topics,
  .area-navigation {
    position: relative;
  }

  .area-content {
    padding: 105px 0;
    background: #fff;
  }

  .area-content::before,
  .wifi-workflow::before,
  .wifi-topics::before,
  .area-navigation::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: min(1160px, calc(100% - 40px));
    height: 1px;
    transform: translateX(-50%);
    background: rgba(11, 18, 32, .10);
  }

  .area-content-grid {
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: 100px;
  }

  .area-content h2,
  .area-navigation-head h2,
  .wifi-section-head h2,
  .wifi-topics-head h2 {
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.5rem, 4.5vw, 4rem);
    line-height: 1.03;
    letter-spacing: -.055em;
  }

  .area-copy p {
    max-width: 680px;
    margin: 0;
    color: rgba(11, 18, 32, .66);
    font-size: 17px;
    line-height: 1.8;
  }

  .wifi-workflow {
    padding: 105px 0 115px;
    background: #fff;
  }

  .wifi-section-head,
  .wifi-topics-head {
    display: grid;
    grid-template-columns: 1fr .85fr;
    gap: 90px;
    align-items: end;
    margin-bottom: 46px;
  }

  .wifi-section-head > p,
  .wifi-topics-head > p {
    margin: 0;
    color: rgba(11, 18, 32, .64);
    font-size: 16px;
    line-height: 1.8;
  }

  .wifi-workflow-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .wifi-work-card {
    display: flex;
    min-height: 350px;
    flex-direction: column;
    padding: 30px;
    border: 1px solid rgba(11, 18, 32, .12);
    border-radius: 22px;
    background: #fff;
    color: #0b1220;
    box-shadow: 0 14px 34px rgba(11, 18, 32, .035);
  }

  .wifi-work-card-dark {
    background: #0b1220;
    border-color: #0b1220;
    color: #fff;
    box-shadow: 0 22px 52px rgba(11, 18, 32, .16);
  }

  .wifi-work-card > span,
  .wifi-topic-grid article > span {
    color: #2563eb;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .wifi-work-card h3 {
    margin: 72px 0 14px;
    font-size: 29px;
    line-height: 1.15;
    letter-spacing: -.045em;
  }

  .wifi-work-card p {
    margin: 0;
    color: rgba(11, 18, 32, .64);
    font-size: 14px;
    line-height: 1.75;
  }

  .wifi-work-card-dark p {
    color: rgba(255, 255, 255, .78);
  }

  .wifi-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 28px;
  }

  .wifi-card-tags span,
  .wifi-card-tags a {
    padding: 8px 10px;
    border: 1px solid rgba(255, 255, 255, .24);
    border-radius: 8px;
    color: #fff;
    font-family: monospace;
    font-size: 11px;
    text-decoration: none;
  }

  .wifi-card-tags-light span,
  .wifi-card-tags-light a {
    border-color: rgba(11, 18, 32, .12);
    color: #0b1220;
  }

  .wifi-card-tags-light a:hover {
    color: #2563eb;
  }

  .wifi-topics {
    padding: 105px 0 115px;
    background: #0b1220;
    color: #fff;
  }

  .wifi-topics::before {
    background: rgba(255, 255, 255, .10);
  }

  .wifi-topics-head h2 {
    color: #fff;
  }

  .wifi-topics-head > p {
    color: rgba(255, 255, 255, .64);
  }

  .wifi-topic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, .14);
    border-left: 1px solid rgba(255, 255, 255, .14);
  }

  .wifi-topic-grid article {
    min-height: 245px;
    padding: 28px;
    border-right: 1px solid rgba(255, 255, 255, .14);
    border-bottom: 1px solid rgba(255, 255, 255, .14);
  }

  .wifi-topic-grid h3 {
    margin: 38px 0 12px;
    color: #fff;
    font-size: 25px;
    line-height: 1.15;
    letter-spacing: -.04em;
  }

  .wifi-topic-grid p {
    margin: 0;
    color: rgba(255, 255, 255, .66);
    font-size: 14px;
    line-height: 1.72;
  }

  .area-navigation {
    padding: 95px 0 110px;
    background: #fff;
  }

  .area-navigation-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 38px;
  }

  .area-navigation-head > a {
    color: #2563eb;
    text-decoration: none;
    font-size: 14px;
    font-weight: 750;
    white-space: nowrap;
  }

  .area-navigation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .area-navigation-card {
    display: flex;
    min-height: 250px;
    flex-direction: column;
    padding: 28px;
    border: 1px solid rgba(11, 18, 32, .12);
    border-radius: 20px;
    background: #fff;
    color: #0b1220;
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }

  .area-navigation-card:hover {
    transform: translateY(-3px);
    border-color: rgba(11, 18, 32, .30);
    box-shadow: 0 18px 45px rgba(11, 18, 32, .07);
  }

  .area-navigation-card > span {
    color: rgba(11, 18, 32, .56);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .area-navigation-card h3 {
    margin: 34px 0 12px;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -.04em;
  }

  .area-navigation-card p {
    margin: 0;
    color: rgba(11, 18, 32, .64);
    font-size: 14px;
    line-height: 1.7;
  }

  .area-navigation-card strong {
    margin-top: auto;
    padding-top: 24px;
    color: #2563eb;
    font-size: 13px;
  }

  @media (max-width: 950px) {
    .area-hero-grid,
    .area-content-grid,
    .wifi-section-head,
    .wifi-topics-head {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .wifi-workflow-grid,
    .wifi-topic-grid {
      grid-template-columns: 1fr;
    }

    .wifi-topic-grid {
      border-left: 0;
    }

    .wifi-topic-grid article {
      min-height: auto;
      border-left: 1px solid rgba(255, 255, 255, .14);
    }
  }

  @media (max-width: 650px) {
    .area-hero { padding: 72px 0 78px; }
    .area-summary { padding: 26px; border-radius: 18px; }
    .area-content,
    .wifi-workflow,
    .wifi-topics { padding: 78px 0; }
    .area-content::before,
    .wifi-workflow::before,
    .wifi-topics::before,
    .area-navigation::before { width: calc(100% - 28px); }
    .wifi-work-card { min-height: auto; padding: 24px; border-radius: 18px; }
    .wifi-work-card h3 { margin-top: 52px; }
    .wifi-topic-grid article { padding: 24px; }
    .area-navigation { padding: 76px 0 82px; }
    .area-navigation-head { align-items: flex-start; flex-direction: column; }
    .area-navigation-grid { grid-template-columns: 1fr; }
    .area-navigation-card { min-height: auto; }
  }
</style>
