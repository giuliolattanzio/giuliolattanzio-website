---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const topics = [
  { label: "Wi-Fi", slug: "wifi", text: "Wireless enterprise, RF, survey e troubleshooting." },
  { label: "Networking", slug: "networking", text: "Reti, VLAN, analisi del traffico e troubleshooting." },
  { label: "Fortinet", slug: "fortinet", text: "FortiGate, VPN, policy e sicurezza di rete." },
  { label: "VoIP", slug: "voip", text: "SIP, call flow, routing e comunicazioni IP." },
  { label: "AudioCodes", slug: "audiocodes", text: "SBC, routing SIP e interoperabilità." },
];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("it-IT", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(date);
---

<Layout
  title={`Articoli | ${config.site.title}`}
  description="Articoli, appunti e approfondimenti tecnici di Giulio Lattanzio su Wi-Fi, networking, Fortinet, VoIP e AudioCodes."
>
  <div class="gl-shell">
    <PersonalHeader active="articoli" />

    <main>
      <section class="gl-section">
        <div class="gl-wrap articles-hero">
          <div>
            <p class="gl-eyebrow">Knowledge Hub</p>
            <h1 class="gl-title">Articoli, appunti e <span>approfondimenti tecnici.</span></h1>
            <p class="gl-lead">
              Uno spazio personale dove raccolgo ciò che studio, sperimento e considero utile documentare
              nel mondo delle reti, del Wi-Fi, della sicurezza e delle comunicazioni IP.
            </p>
          </div>
          <div class="hero-actions">
            <a class="gl-button gl-button-primary" href="/search/">Cerca negli articoli →</a>
            <a class="gl-button gl-button-secondary" href="/rss.xml">RSS</a>
          </div>
        </div>
      </section>

      <section class="topics-band">
        <div class="gl-wrap topics-grid">
          {topics.map((topic, index) => (
            <a class="topic-card" href={`/tags/${topic.slug}/`}>
              <span>0{index + 1}</span>
              <h2>{topic.label}</h2>
              <p>{topic.text}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="gl-section gl-section-white">
        <div class="gl-wrap">
          <div class="section-heading">
            <div>
              <p class="gl-eyebrow">Archivio</p>
              <h2>Ultimi contenuti</h2>
            </div>
            <a href="/tags/">Tutti gli argomenti →</a>
          </div>

          {page.data.length > 0 ? (
            <div class="gl-article-list">
              {page.data.map(post => (
                <a class="gl-article-card" href={getPostUrl(post.id, post.filePath, locale)}>
                  <div>
                    <div class="gl-meta">{formatDate(post.data.pubDatetime)}</div>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <div class="gl-tag-list card-tags">
                      {post.data.tags.slice(0, 5).map(tag => <span class="gl-tag">{tag}</span>)}
                    </div>
                  </div>
                  <span class="gl-arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <h3>Nessun articolo pubblicato.</h3>
              <p>I nuovi contenuti compariranno qui automaticamente.</p>
            </div>
          )}

          {(page.url.prev || page.url.next) && (
            <nav class="gl-pagination" aria-label="Paginazione articoli">
              <span>{page.url.prev && <a href={page.url.prev}>← Più recenti</a>}</span>
              <span>{page.url.next && <a href={page.url.next}>Più vecchi →</a>}</span>
            </nav>
          )}
        </div>
      </section>
    </main>

    <PersonalFooter />
  </div>
</Layout>

<style>
  .articles-hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 60px;
  }
  .hero-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .topics-band { background: #fff; border-top: 1px solid #e4e7ec; border-bottom: 1px solid #e4e7ec; }
  .topics-grid { display: grid; grid-template-columns: repeat(5, 1fr); }
  .topic-card { padding: 28px 24px; color: inherit; text-decoration: none; border-right: 1px solid #e4e7ec; }
  .topic-card:first-child { border-left: 1px solid #e4e7ec; }
  .topic-card > span { color: #2563eb; font-family: monospace; font-size: 12px; }
  .topic-card h2 { margin: 28px 0 8px; color: #0b1220; font-size: 20px; }
  .topic-card p { margin: 0; color: #667085; font-size: 13px; line-height: 1.6; }
  .topic-card:hover h2 { color: #2563eb; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 34px; }
  .section-heading h2 { margin: 0; color: #0b1220; font-size: 36px; letter-spacing: -0.04em; }
  .section-heading a { color: #2563eb; text-decoration: none; font-weight: 700; font-size: 14px; }
  .card-tags { margin-top: 18px; }
  .empty-state { padding: 40px; border: 1px solid #e4e7ec; border-radius: 16px; background: #f7f9fc; }
  .empty-state h3 { margin: 0 0 6px; color: #0b1220; }
  .empty-state p { margin: 0; color: #667085; }
  @media (max-width: 950px) {
    .articles-hero { grid-template-columns: 1fr; gap: 30px; }
    .topics-grid { grid-template-columns: repeat(2, 1fr); }
    .topic-card { border-bottom: 1px solid #e4e7ec; }
  }
  @media (max-width: 650px) {
    .topics-grid { grid-template-columns: 1fr; }
    .topic-card { border-left: 1px solid #e4e7ec; }
    .section-heading { align-items: flex-start; flex-direction: column; }
  }
</style>
