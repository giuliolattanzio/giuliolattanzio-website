---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import { TECHNICAL_AREAS } from "@/data/technicalAreas";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const isFirstPage = page.currentPage === 1;
const pageTitle = isFirstPage
  ? `Articoli e Knowledge Hub | ${config.site.title}`
  : `Articoli – Pagina ${page.currentPage} | ${config.site.title}`;
const pageDescription = isFirstPage
  ? "Knowledge Hub tecnico di Giulio Lattanzio: articoli e approfondimenti su Wi-Fi, networking, sicurezza, VoIP, AudioCodes e troubleshooting."
  : `Archivio degli articoli tecnici di Giulio Lattanzio, pagina ${page.currentPage}.`;

const areaCopy: Record<string, string> = {
  wifi: "RF design, site survey, Ekahau, analisi e troubleshooting wireless.",
  "networking-security": "Reti IP, switching, VLAN, Fortinet, Alcatel, VPN e analisi del traffico.",
  voip: "SIP, AudioCodes SBC, call flow, routing e interoperabilità tra piattaforme.",
};
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="gl-shell">
    <PersonalHeader active="articoli" />

    <main>
      <section class="gl-section articles-hero-section">
        <div class="gl-wrap articles-hero">
          <div>
            <p class="gl-eyebrow">Knowledge Hub</p>
            <h1 class="gl-title">Esperienze, analisi e <span>approfondimenti tecnici.</span></h1>
            <p class="gl-lead">
              Una raccolta di articoli e appunti su Wi-Fi, networking, sicurezza e comunicazioni IP,
              nati dall’esperienza operativa, dall’analisi dei problemi e dallo studio delle tecnologie.
            </p>
          </div>
          <div class="hero-actions">
            <a class="gl-button gl-button-primary" href="/search/">Cerca negli articoli →</a>
            <a class="gl-button gl-button-secondary" href="/rss.xml">RSS</a>
          </div>
        </div>
      </section>

      <section class="areas-section">
        <div class="gl-wrap">
          <div class="areas-head">
            <div>
              <p class="gl-eyebrow">Aree tecniche</p>
              <h2>Esplora i contenuti per macro-area.</h2>
            </div>
            <p>
              Le tre aree principali organizzano il Knowledge Hub. I tag restano disponibili per scendere nel dettaglio
              su tecnologie, protocolli e argomenti specifici senza frammentare la navigazione principale.
            </p>
          </div>

          <div class="areas-grid">
            {TECHNICAL_AREAS.map(area => (
              <a class="area-card" href={`/${area.slug}/`}>
                <div class="area-card-top">
                  <span>{area.eyebrow}</span>
                  <strong aria-hidden="true">↗</strong>
                </div>
                <h2>{area.title}</h2>
                <p>{areaCopy[area.slug] ?? area.description}</p>
                <span class="area-link">Esplora l’area →</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="gl-section gl-section-white archive-section">
        <div class="gl-wrap">
          <div class="section-heading">
            <div>
              <p class="gl-eyebrow">Archivio</p>
              <h2>{isFirstPage ? "Tutti gli articoli." : `Articoli — pagina ${page.currentPage}.`}</h2>
            </div>
            <a href="/tags/">Esplora tutti gli argomenti →</a>
          </div>

          {page.data.length > 0 ? (
            <div class="gl-article-list">
              {page.data.map(post => (
                <a class="gl-article-card" href={getPostUrl(post.id, post.filePath, locale)}>
                  <div>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <div class="gl-tag-list card-tags">
                      {post.data.tags.slice(0, 5).map(tag => <span class="gl-tag">{tag}</span>)}
                    </div>
                  </div>
                  <span class="gl-arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <h3>Nessun articolo pubblicato.</h3>
              <p>I nuovi contenuti compariranno qui automaticamente.</p>
            </div>
          )}

          {(page.url.prev || page.url.next) && (
            <nav class="gl-pagination" aria-label="Paginazione articoli">
              <span>{page.url.prev && <a href={page.url.prev}>← Più recenti</a>}</span>
              <span>{page.url.next && <a href={page.url.next}>Più vecchi →</a>}</span>
            </nav>
          )}
        </div>
      </section>
    </main>

    <PersonalFooter />
  </div>
</Layout>

<style>
  .articles-hero-section {
    padding-top: 105px;
    padding-bottom: 100px;
  }

  .articles-hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 70px;
  }

  .articles-hero .gl-lead {
    max-width: 780px;
  }

  .hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .areas-section {
    padding: 105px 0 115px;
    background: #fff;
    border-top: 1px solid rgba(11, 18, 32, .10);
    border-bottom: 1px solid rgba(11, 18, 32, .10);
  }

  .areas-head {
    display: grid;
    grid-template-columns: 1fr .8fr;
    gap: 90px;
    align-items: end;
    margin-bottom: 44px;
  }

  .areas-head h2,
  .section-heading h2 {
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.5rem, 4.5vw, 4rem);
    line-height: 1.03;
    letter-spacing: -.055em;
  }

  .areas-head > p {
    margin: 0;
    color: rgba(11, 18, 32, .64);
    font-size: 16px;
    line-height: 1.8;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .area-card {
    display: flex;
    min-height: 310px;
    flex-direction: column;
    padding: 28px;
    border: 1px solid rgba(11, 18, 32, .12);
    border-radius: 20px;
    background: #fff;
    color: #0b1220;
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }

  .area-card:hover {
    transform: translateY(-3px);
    border-color: rgba(11, 18, 32, .28);
    box-shadow: 0 18px 44px rgba(11, 18, 32, .07);
  }

  .area-card-top {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: rgba(11, 18, 32, .56);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .area-card-top strong {
    color: #0b1220;
    font-size: 19px;
    font-weight: 500;
  }

  .area-card h2 {
    margin: 62px 0 12px;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -.045em;
  }

  .area-card p {
    margin: 0;
    color: rgba(11, 18, 32, .64);
    font-size: 14px;
    line-height: 1.7;
  }

  .area-link {
    margin-top: auto;
    padding-top: 24px;
    color: #2563eb;
    font-size: 13px;
    font-weight: 750;
  }

  .archive-section {
    padding-top: 105px;
    padding-bottom: 110px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin-bottom: 38px;
  }

  .section-heading a {
    color: #2563eb;
    text-decoration: none;
    font-weight: 750;
    font-size: 14px;
    white-space: nowrap;
  }

  .card-tags {
    margin-top: 18px;
  }

  .empty-state {
    padding: 40px;
    border: 1px solid rgba(11, 18, 32, .12);
    border-radius: 16px;
    background: #fff;
  }

  .empty-state h3 {
    margin: 0 0 6px;
    color: #0b1220;
  }

  .empty-state p {
    margin: 0;
    color: rgba(11, 18, 32, .62);
  }

  @media (max-width: 950px) {
    .articles-hero,
    .areas-head {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-actions {
      justify-content: flex-start;
    }

    .areas-grid {
      grid-template-columns: 1fr;
    }

    .area-card {
      min-height: 260px;
    }
  }

  @media (max-width: 650px) {
    .articles-hero-section {
      padding-top: 72px;
      padding-bottom: 78px;
    }

    .areas-section,
    .archive-section {
      padding-top: 78px;
      padding-bottom: 82px;
    }

    .area-card {
      min-height: auto;
      padding: 24px;
      border-radius: 18px;
    }

    .area-card h2 {
      margin-top: 48px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
