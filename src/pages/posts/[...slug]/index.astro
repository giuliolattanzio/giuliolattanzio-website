---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const sortedPosts = getSortedPosts(posts);

  return sortedPosts.map((post, index) => {
    const currentTags = new Set(post.data.tags.map(tag => slugifyStr(tag)));
    const scored = sortedPosts
      .filter(candidate => candidate.id !== post.id)
      .map(candidate => ({
        post: candidate,
        score: candidate.data.tags.reduce(
          (total, tag) => total + (currentTags.has(slugifyStr(tag)) ? 1 : 0),
          0
        ),
      }))
      .filter(item => item.score > 0)
      .sort(
        (a, b) =>
          b.score - a.score ||
          b.post.data.pubDatetime.valueOf() - a.post.data.pubDatetime.valueOf()
      )
      .map(item => item.post);

    const fallback = [
      index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null,
      index > 0 ? sortedPosts[index - 1] : null,
    ].filter(Boolean) as CollectionEntry<"posts">[];

    const relatedPosts = [...scored];
    for (const candidate of fallback) {
      if (relatedPosts.length >= 2) break;
      if (!relatedPosts.some(item => item.id === candidate.id)) relatedPosts.push(candidate);
    }

    return {
      params: { slug: getPostSlug(post.id, post.filePath) },
      props: { post, relatedPosts: relatedPosts.slice(0, 2) },
    };
  });
}

type Props = {
  post: CollectionEntry<"posts">;
  relatedPosts: CollectionEntry<"posts">[];
};

const { post, relatedPosts } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const { Content } = await render(post);

const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  author,
} = post.data;

let explicitImageUrl: string | undefined;
if (typeof initOgImage === "string") explicitImageUrl = initOgImage;
else if (initOgImage?.src) explicitImageUrl = initOgImage.src;

const postUrl = getPostUrl(post.id, post.filePath, locale).replace(/\/+$/, "");
let ogImageUrl: string | undefined;
if (explicitImageUrl) {
  // Keep the original optimized cover on the article page, but expose a
  // predictable JPEG 1200x627 to LinkedIn and other social crawlers.
  ogImageUrl = `${postUrl}/social.jpg`;
} else if (config.features.dynamicOgImage) {
  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.site ?? Astro.url).href
  : undefined;
const coverImage = explicitImageUrl;

const tagLabels: Record<string, string> = {
  wifi: "Wi-Fi",
  networking: "Networking",
  alcatel: "Alcatel",
  fortinet: "Fortinet",
  fortigate: "FortiGate",
  vlan: "VLAN",
  routing: "Routing",
  vpn: "VPN",
  ipsec: "IPsec",
  voip: "VoIP",
  sip: "SIP",
  audiocodes: "AudioCodes",
  "audiocodes-sbc": "AudioCodes SBC",
  "call-flow": "Call Flow",
  interoperabilita: "Interoperabilità",
  ekahau: "Ekahau",
  "site-survey": "Site Survey",
  "survey-wifi": "Survey Wi-Fi",
  "analisi-wifi": "Analisi Wi-Fi",
  troubleshooting: "Troubleshooting",
  wireshark: "Wireshark",
  security: "Security",
  "microsoft-teams": "Microsoft Teams",
};

const formatTag = (tag: string) => tagLabels[slugifyStr(tag)] ?? tag;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  headline={title}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <div class="gl-shell">
    <PersonalHeader active="articoli" />

    <main data-pagefind-body>
      <header class="article-hero">
        <div class="article-heading-wrap">
          <a class="gl-back" href="/posts/">← Knowledge Hub</a>
          <p class="gl-eyebrow">Approfondimento tecnico</p>
          <h1 class="article-title">{title}</h1>
          <p class="article-description">{description}</p>

          <div class="article-info" aria-label="Informazioni articolo">
            <div class="article-info-item">
              <span class="info-label">Autore</span>
              <strong>{author}</strong>
            </div>
          </div>

          <div class="gl-tag-list article-tags" aria-label="Argomenti dell'articolo">
            {tags.map(tag => (
              <a class="gl-tag" href={`/tags/${slugifyStr(tag)}/`}>{formatTag(tag)}</a>
            ))}
          </div>
        </div>
      </header>

      {coverImage && (
        <div class="cover-area">
          <div class="article-heading-wrap">
            <img
              class="cover-image"
              src={coverImage}
              alt={`Immagine di copertina dell'articolo: ${title}`}
              width="1200"
              height="675"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      )}

      <section class="article-content-section">
        <article id="article" class="gl-article-wrap gl-prose">
          <Content />
        </article>
      </section>

      <section class="article-end">
        <div class="gl-article-wrap">
          <div class="article-end-head">
            <div>
              <p class="gl-eyebrow">Continua a esplorare</p>
              <h2>Approfondimenti correlati.</h2>
            </div>
            <a class="all-posts-link" href="/posts/">Tutti gli articoli →</a>
          </div>

          {relatedPosts.length > 0 && (
            <div class="related-grid">
              {relatedPosts.map(related => (
                <a class="related-card" href={getPostUrl(related.id, related.filePath, locale)}>
                  <span>Articolo correlato</span>
                  <strong>{related.data.title}</strong>
                  <small>{related.data.description}</small>
                </a>
              ))}
            </div>
          )}
        </div>
      </section>
    </main>

    <PersonalFooter />
  </div>
</PostLayout>

<style>
  .article-hero {
    padding: 88px 0 62px;
    background: #f7f9fc;
  }

  .article-heading-wrap {
    width: min(960px, calc(100% - 40px));
    margin-inline: auto;
  }

  .article-title {
    max-width: 920px;
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.75rem, 5vw, 4.7rem);
    line-height: 1.02;
    letter-spacing: -0.06em;
  }

  .article-description {
    max-width: 780px;
    margin: 26px 0 0;
    color: #667085;
    font-size: 19px;
    line-height: 1.75;
  }

  .article-info {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 36px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid #e4e7ec;
  }

  .article-info-item { min-width: 130px; }

  .info-label {
    display: block;
    margin-bottom: 4px;
    color: #98a2b3;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .article-info strong {
    color: #344054;
    font-size: 13px;
    font-weight: 650;
  }

  .article-tags { margin-top: 22px; }

  .cover-area {
    padding: 0 0 62px;
    background: #f7f9fc;
  }

  .cover-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 540px;
    object-fit: contain;
    background: #fff;
    border: 1px solid #e4e7ec;
    border-radius: 22px;
    box-shadow: 0 24px 60px rgba(16, 24, 40, .08);
  }

  .article-content-section {
    padding-top: 8px;
    background: #fff;
    border-top: 1px solid #e4e7ec;
  }

  .gl-prose { padding-top: 64px; }

  .article-end {
    padding: 70px 0;
    background: #f7f9fc;
    border-top: 1px solid #e4e7ec;
  }

  .article-end-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 28px;
  }

  .article-end-head h2 {
    margin: 0;
    color: #0b1220;
    font-size: clamp(1.8rem, 4vw, 2.7rem);
    line-height: 1.08;
    letter-spacing: -.045em;
  }

  .all-posts-link {
    flex: 0 0 auto;
    color: #2563eb;
    text-decoration: none;
    font-size: 14px;
    font-weight: 750;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .related-card {
    display: flex;
    min-height: 175px;
    flex-direction: column;
    padding: 24px;
    background: #fff;
    border: 1px solid #e4e7ec;
    border-radius: 16px;
    color: #0b1220;
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }

  .related-card:hover {
    transform: translateY(-2px);
    border-color: #93c5fd;
    box-shadow: 0 16px 40px rgba(16,24,40,.06);
  }

  .related-card span {
    margin-bottom: 12px;
    color: #2563eb;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .related-card strong {
    margin-bottom: 12px;
    font-size: 19px;
    line-height: 1.3;
  }

  .related-card small {
    color: #667085;
    font-size: 13px;
    line-height: 1.65;
  }

  @media(max-width: 720px) {
    .article-hero { padding: 68px 0 48px; }
    .article-title { font-size: clamp(2.35rem, 11vw, 3.5rem); }
    .article-description { font-size: 17px; }
    .article-heading-wrap { width: min(100% - 30px, 960px); }
    .related-grid { grid-template-columns: 1fr; }
    .article-end-head { align-items: start; flex-direction: column; }
  }
</style>