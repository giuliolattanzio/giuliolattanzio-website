---
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import config from "@/config";
---

<Layout
  title={`Archivio | ${config.site.title}`}
  description="Archivio degli articoli tecnici di Giulio Lattanzio."
>
  <div class="gl-shell">
    <PersonalHeader active="articoli" />
    <main>
      <section class="gl-section">
        <div class="gl-wrap legacy-page">
          <p class="gl-eyebrow">Archivio</p>
          <h1 class="gl-title">Tutti i contenuti sono nel <span>Knowledge Hub.</span></h1>
          <p class="gl-lead">
            L'archivio è stato semplificato: articoli, argomenti e ricerca sono ora raccolti nella sezione Articoli.
          </p>
          <a class="gl-button gl-button-primary" href="/posts/">Vai agli articoli →</a>
        </div>
      </section>
    </main>
    <PersonalFooter />
  </div>
</Layout>

<style>
  .legacy-page { max-width: 900px; }
  .legacy-page .gl-button { margin-top: 30px; }
</style>
