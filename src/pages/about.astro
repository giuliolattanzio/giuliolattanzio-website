---
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import config from "@/config";
---

<Layout
  title={`Profilo | ${config.site.title}`}
  description="Presentazione personale e professionale di Giulio Lattanzio."
>
  <div class="gl-shell">
    <PersonalHeader active="profilo" />
    <main>
      <section class="gl-section">
        <div class="gl-wrap legacy-page">
          <p class="gl-eyebrow">Profilo</p>
          <h1 class="gl-title">Chi sono e <span>cosa faccio.</span></h1>
          <p class="gl-lead">
            La mia presentazione personale è stata spostata nella nuova pagina Profilo, integrata con il resto del sito.
          </p>
          <a class="gl-button gl-button-primary" href="/profilo/">Vai al Profilo →</a>
        </div>
      </section>
    </main>
    <PersonalFooter />
  </div>
</Layout>

<style>
  .legacy-page { max-width: 900px; }
  .legacy-page .gl-button { margin-top: 30px; }
</style>
