---
import Layout from "@/layouts/Layout.astro";
import PersonalHeader from "@/components/PersonalHeader.astro";
import PersonalFooter from "@/components/PersonalFooter.astro";
import config from "@/config";
---

<Layout title={`Pagina non trovata | ${config.site.title}`}>
  <div class="gl-shell">
    <PersonalHeader />
    <main class="not-found">
      <div class="gl-wrap center">
        <p class="gl-eyebrow">Errore 404</p>
        <h1 class="gl-title">Pagina <span>non trovata.</span></h1>
        <p class="gl-lead">Il contenuto che stai cercando non esiste o è stato spostato.</p>
        <div class="actions">
          <a class="gl-button gl-button-primary" href="/">Torna alla Home</a>
          <a class="gl-button gl-button-secondary" href="/posts/">Vai agli articoli</a>
        </div>
      </div>
    </main>
    <PersonalFooter />
  </div>
</Layout>

<style>
  .not-found { min-height: calc(100vh - 198px); display: grid; place-items: center; padding: 70px 0; }
  .center { text-align: center; }
  .center .gl-lead { margin-inline: auto; }
  .actions { margin-top: 30px; display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
</style>
