---
type Props = {
  active?: "home" | "profilo" | "articoli" | "search";
};

const { active } = Astro.props;
---

<header class="gl-topbar">
  <div class="gl-wrap gl-nav-wrap">
    <a class="gl-brand" href="/" aria-label="Giulio Lattanzio - Home">
      <img
        class="gl-brand-logo"
        src="/images/branding/giuliolattanzio_logo.png"
        alt="Logo Giulio Lattanzio"
        width="48"
        height="48"
      />
      <span class="gl-brand-copy">
        <strong>Giulio Lattanzio</strong>
        <small>Network & Security Specialist</small>
      </span>
    </a>

    <nav class="gl-nav" aria-label="Navigazione principale">
      <a class:list={[{ active: active === "profilo" }]} href="/profilo/">Profilo</a>
      <a class:list={[{ active: active === "articoli" }]} href="/posts/">Articoli</a>
      <a class:list={[{ active: active === "search" }]} href="/search/">Cerca</a>
      <a href="/#stack">Tecnologie</a>
    </nav>
  </div>
</header>
