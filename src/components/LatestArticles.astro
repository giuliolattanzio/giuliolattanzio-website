---
import { getCollection } from "astro:content";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

type Props = {
  tags?: string[];
  eyebrow?: string;
  heading?: string;
  archiveHref?: string;
  archiveLabel?: string;
  emptyText?: string;
};

const {
  tags = [],
  eyebrow = "Ultimi articoli",
  heading = "Gli ultimi contenuti pubblicati.",
  archiveHref = "/posts/",
  archiveLabel = "Tutti gli articoli →",
  emptyText = "I nuovi contenuti appariranno qui.",
} = Astro.props;

const posts = await getCollection("posts", ({ data }) => !data.draft);
const requestedTags = new Set(tags.map(tag => slugifyStr(tag)));
const latestPosts = getSortedPosts(posts)
  .filter(post =>
    requestedTags.size === 0 ||
    post.data.tags?.some(tag => requestedTags.has(slugifyStr(tag)))
  )
  .slice(0, 3);

const locale = Astro.currentLocale ?? config.site.lang;
---

<section class="latest-section gl-section-white">
  <div class="gl-wrap">
    <div class="latest-head">
      <div>
        <p class="gl-eyebrow">{eyebrow}</p>
        <h2>{heading}</h2>
      </div>
      <a href={archiveHref}>{archiveLabel}</a>
    </div>

    {latestPosts.length > 0 ? (
      <div class="latest-grid">
        {latestPosts.map(post => (
          <a class="latest-card" href={getPostUrl(post.id, post.filePath, locale)}>
            {post.data.tags?.[0] && (
              <div class="latest-meta">
                <span>{post.data.tags[0]}</span>
              </div>
            )}
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="read-more">Leggi l’articolo →</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="latest-empty">
        <p>{emptyText}</p>
      </div>
    )}
  </div>
</section>

<style>
  .latest-section {
    padding: 104px 0 112px;
    border-top: 1px solid rgba(11, 18, 32, .10);
  }

  .latest-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 42px;
  }

  .latest-head h2 {
    max-width: 720px;
    margin: 0;
    color: #0b1220;
    font-size: clamp(2.3rem, 4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -.055em;
  }

  .latest-head > a {
    color: #2563eb;
    text-decoration: none;
    font-size: 14px;
    font-weight: 750;
    white-space: nowrap;
  }

  .latest-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid rgba(11, 18, 32, .14);
  }

  .latest-card {
    position: relative;
    display: flex;
    min-height: 310px;
    flex-direction: column;
    padding: 30px 28px 26px;
    background: #fff;
    border-right: 1px solid rgba(11, 18, 32, .12);
    border-bottom: 1px solid rgba(11, 18, 32, .12);
    color: inherit;
    text-decoration: none;
    transition: background .2s ease, transform .2s ease;
  }

  .latest-card:first-child {
    border-left: 1px solid rgba(11, 18, 32, .12);
  }

  .latest-card::before {
    content: "";
    position: absolute;
    inset: -1px auto auto 0;
    width: 0;
    height: 2px;
    background: #2563eb;
    transition: width .2s ease;
  }

  .latest-card:hover {
    transform: translateY(-2px);
    background: rgba(11, 18, 32, .018);
  }

  .latest-card:hover::before {
    width: 100%;
  }

  .latest-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    color: rgba(11, 18, 32, .52);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .latest-card h3 {
    margin: 44px 0 14px;
    color: #0b1220;
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    line-height: 1.2;
    letter-spacing: -.04em;
  }

  .latest-card p {
    margin: 0;
    color: rgba(11, 18, 32, .62);
    font-size: 14px;
    line-height: 1.68;
  }

  .read-more {
    margin-top: auto;
    padding-top: 28px;
    color: #2563eb;
    font-size: 13px;
    font-weight: 750;
  }

  .latest-empty {
    padding: 36px;
    border: 1px solid rgba(11, 18, 32, .12);
  }

  .latest-empty p {
    margin: 0;
    color: rgba(11, 18, 32, .62);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .latest-grid {
      grid-template-columns: 1fr;
    }

    .latest-card,
    .latest-card:first-child {
      min-height: auto;
      border-left: 1px solid rgba(11, 18, 32, .12);
    }
  }

  @media (max-width: 650px) {
    .latest-section {
      padding: 76px 0 84px;
    }

    .latest-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .latest-card {
      padding: 26px 24px;
    }

    .latest-card h3 {
      margin-top: 34px;
    }
  }
</style>
