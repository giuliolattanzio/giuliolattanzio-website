---
import { getCollection } from "astro:content";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

type Props = {
  tags?: string[];
  eyebrow?: string;
  heading?: string;
  archiveHref?: string;
  archiveLabel?: string;
  emptyText?: string;
};

const {
  tags = [],
  eyebrow = "Ultimi articoli",
  heading = "Gli ultimi contenuti pubblicati.",
  archiveHref = "/posts/",
  archiveLabel = "Tutti gli articoli →",
  emptyText = "I nuovi contenuti appariranno qui.",
} = Astro.props;

const posts = await getCollection("posts", ({ data }) => !data.draft);
const requestedTags = new Set(tags.map(tag => slugifyStr(tag)));
const latestPosts = getSortedPosts(posts)
  .filter(post =>
    requestedTags.size === 0 ||
    post.data.tags?.some(tag => requestedTags.has(slugifyStr(tag)))
  )
  .slice(0, 3);

const locale = Astro.currentLocale ?? config.site.lang;
const formatDate = (date: Date) => new Intl.DateTimeFormat("it-IT", {
  day: "2-digit",
  month: "short",
  year: "numeric",
}).format(date);
---

<section class="latest-section gl-section-white">
  <div class="gl-wrap">
    <div class="latest-head">
      <div>
        <p class="gl-eyebrow">{eyebrow}</p>
        <h2>{heading}</h2>
      </div>
      <a href={archiveHref}>{archiveLabel}</a>
    </div>

    {latestPosts.length > 0 ? (
      <div class="latest-grid">
        {latestPosts.map(post => {
          const image = post.data.ogImage || "/default-og.jpg";
          const imageSrc = typeof image === "string" ? image : image.src;
          return (
            <a class="latest-card" href={getPostUrl(post.id, post.filePath, locale)}>
              <div class="latest-media">
                <img src={imageSrc} alt={post.data.title} loading="lazy" decoding="async" />
              </div>
              <div class="latest-body">
                <div class="latest-meta">
                  <time datetime={post.data.pubDatetime.toISOString()}>{formatDate(post.data.pubDatetime)}</time>
                  {post.data.tags?.[0] && <span>{post.data.tags[0]}</span>}
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="read-more">Leggi l’articolo →</span>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="latest-empty">
        <p>{emptyText}</p>
      </div>
    )}
  </div>
</section>

<style>
  .latest-section { padding: 104px 0 112px; border-top: 1px solid rgba(11,18,32,.10); }
  .latest-head { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 42px; }
  .latest-head h2 { max-width: 720px; margin: 0; color: #0b1220; font-size: clamp(2.3rem,4vw,3.6rem); line-height: 1.05; letter-spacing: -.055em; }
  .latest-head > a { color: #2563eb; text-decoration: none; font-size: 14px; font-weight: 750; white-space: nowrap; }

  .latest-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
  .latest-card { overflow: hidden; display: flex; min-height: 100%; flex-direction: column; border: 1px solid rgba(11,18,32,.12); border-radius: 20px; background: #fff; color: inherit; text-decoration: none; box-shadow: 0 8px 28px rgba(11,18,32,.035); transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
  .latest-card:hover { transform: translateY(-5px); border-color: rgba(37,99,235,.28); box-shadow: 0 20px 48px rgba(11,18,32,.09); }
  .latest-media { aspect-ratio: 16 / 9; overflow: hidden; background: #eef2f7; }
  .latest-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .latest-card:hover .latest-media img { transform: scale(1.025); }
  .latest-body { display: flex; flex: 1; flex-direction: column; padding: 22px 22px 24px; }
  .latest-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 14px; color: rgba(11,18,32,.52); font-size: 10px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .latest-card h3 { margin: 18px 0 14px; color: #0b1220; font-size: clamp(1.35rem,2vw,1.65rem); line-height: 1.2; letter-spacing: -.04em; }
  .latest-card p { margin: 0; color: rgba(11,18,32,.62); font-size: 14px; line-height: 1.68; }
  .read-more { margin-top: auto; padding-top: 28px; color: #2563eb; font-size: 13px; font-weight: 750; }
  .latest-empty { padding: 36px; border: 1px solid rgba(11,18,32,.12); }
  .latest-empty p { margin: 0; color: rgba(11,18,32,.62); line-height: 1.7; }

  @media (max-width: 900px) { .latest-grid { grid-template-columns: 1fr; } }
  @media (max-width: 650px) {
    .latest-section { padding: 76px 0 84px; }
    .latest-head { align-items: flex-start; flex-direction: column; }
    .latest-body { padding: 20px; }
  }
</style>
